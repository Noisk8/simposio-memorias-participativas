# Credencial server-side para GitHub Contents API. Actualmente se usa un token
# fine-grained limitado a este repositorio y con Contents: Read/Write.
# La integración mediante GitHub App está planeada, no implementada.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx

# Repositorio donde se versiona el Markdown (public/images/ solo conserva legacy).
GITHUB_REPO=Noisk8/simposio-memorias-participativas

# Origen permitido para llamadas CORS desde el frontend.
SITE_URL=https://simposio-memorias-participativas.netlify.app

# Lista opcional de orígenes adicionales, separados por comas (previews autorizados).
ALLOWED_ORIGINS=https://deploy-preview-123--sitio.netlify.app

# Rama donde las Functions escriben directamente (opcional; por defecto main).
GITHUB_BRANCH=main

# ── Supabase Auth (paneles de administración) ─────────────────────────────────
# URL del proyecto (Dashboard → Settings → API).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Clave service_role (NUNCA exponer en el cliente ni en el repositorio).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# HMAC opcional para anonimizar sujetos del rate limit distribuido. Si se omite,
# el backend usa SUPABASE_SERVICE_ROLE_KEY como clave con separación de dominio.
# RATE_LIMIT_HMAC_KEY=replace-with-at-least-32-random-bytes

# Versiones públicas de la URL y la anon key (seguras para el navegador).
PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Los administradores iniciales se predeclaran en public.admin_emails.
# Aplica primero, en orden, las migraciones de supabase/migrations/.

# Correo de alta opcional. Sin estas variables la cuenta se crea igualmente y
# el panel muestra la contraseña temporal para comunicarla por otro canal.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=panel@example.org

# Política server-side de imágenes. Todo archivo tiene un máximo absoluto de
# 2 MiB impuesto en backend, PostgreSQL y Storage.
# CMS_IMAGE_MAX_WIDTH=8000
# CMS_IMAGE_MAX_HEIGHT=8000
# CMS_IMAGE_MAX_PIXELS=40000000

# Webhook de alertas (opcional): cada error 5xx de las Functions se envía como
# POST JSON {"text": "..."} a esta URL. Compatible con Slack y Discord.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
