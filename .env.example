# Token fine-grained o GitHub App con acceso SOLO a este repositorio y Contents: Read/Write.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Repositorio donde se guardan las memorias.
GITHUB_REPO=Noisk8/test-simposio-memorias-participativas

# Origen permitido para llamadas CORS desde el frontend.
SITE_URL=https://simposio-memorias-participativas.netlify.app

# Rama donde se crean los archivos (opcional, por defecto main).
GITHUB_BRANCH=main

# Emails de administradores separados por coma. Estos usuarios:
# - Reciben el rol "admin" automáticamente al registrarse.
# - Pueden gestionar usuarios y colecciones aunque aún no tengan el rol en su token.
ADMIN_EMAILS=tu-email@ejemplo.com
