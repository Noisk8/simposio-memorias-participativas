{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "draft": {
      "default": false,
      "type": "boolean"
    },
    "publish_date": {
      "default": "",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "string",
          "format": "date-time"
        }
      ]
    },
    "simposio": {
      "default": "2026",
      "type": "string"
    },
    "number": {
      "type": "number"
    },
    "title": {
      "type": "string"
    },
    "place": {
      "type": "string"
    },
    "author": {
      "default": "",
      "type": "string"
    },
    "collective": {
      "default": "",
      "type": "string"
    },
    "categories": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "image": {
      "type": "string"
    },
    "description": {
      "default": "",
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "number",
    "title",
    "place",
    "image"
  ]
}