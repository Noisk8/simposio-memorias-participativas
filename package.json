{
  "name": "simposio-memorias",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync": "node scripts/sync-collections.mjs",
    "dev": "astro dev",
    "dev:netlify": "netlify dev",
    "build": "node scripts/sync-collections.mjs --check && node scripts/migrate-content-uuids.mjs --check && astro build && npx pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "check": "node scripts/lint-taxonomies.mjs && node scripts/migrate-content-uuids.mjs --check && astro check",
    "check:content-uuids": "node scripts/migrate-content-uuids.mjs --check",
    "check:taxonomies": "node scripts/lint-taxonomies.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:api": "node scripts/test-api-contract.mjs",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint src scripts netlify shared tests e2e",
    "lint:fix": "eslint src scripts netlify shared tests e2e --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "@astrojs/react": "^6.0.0",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.3",
    "@supabase/supabase-js": "^2.112.0",
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@playwright/test": "^1.62.1",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^10.6.0",
    "eslint-plugin-astro": "^1.7.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.4",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  }
}
