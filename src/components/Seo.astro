---
import {
  NETWORK_TITLE,
  NETWORK_DESCRIPTION,
  NETWORK_INSTAGRAM,
  SITE_URL,
  SITE_LANG,
  SITE_KEYWORDS,
  DEFAULT_OG_IMAGE,
  THEME_COLOR,
  AUTHOR,
} from '../consts';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'event';
  noindex?: boolean;
  nofollow?: boolean;
  canonical?: string;
  lang?: string;
  author?: string;
  publishDate?: Date | string;
  modifiedDate?: Date | string;
  tags?: string[];
  section?: string;
  keywords?: string[];
  ogTitle?: string;
  ogDescription?: string;
  twitterHandle?: string;
}

const {
  title = NETWORK_TITLE,
  description = NETWORK_DESCRIPTION,
  image = DEFAULT_OG_IMAGE,
  type = 'website',
  noindex = false,
  nofollow = false,
  canonical,
  lang = SITE_LANG,
  author = AUTHOR,
  publishDate,
  modifiedDate,
  tags = [],
  section,
  keywords = SITE_KEYWORDS,
  ogTitle,
  ogDescription,
  twitterHandle,
} = Astro.props;

const origin = Astro.url.origin;
const canonicalUrl = canonical || Astro.url.href;
const resolvedImage = image.startsWith('http') ? image : new URL(image, origin).toString();
const pageTitle = title.includes(NETWORK_TITLE) ? title : `${title} · ${NETWORK_TITLE}`;
const pageOgTitle = ogTitle || pageTitle;
const pageOgDescription = ogDescription || description;

const robotsContent = [noindex ? 'noindex' : 'index', nofollow ? 'nofollow' : 'follow', 'max-snippet:-1, max-image-preview:large, max-video-preview:-1'].join(', ');

const formatDate = (date: Date | string | undefined) => {
  if (!date) return undefined;
  const d = typeof date === 'string' ? new Date(date) : date;
  return d.toISOString();
};

const publishedTime = formatDate(publishDate);
const modifiedTime = formatDate(modifiedDate);

// Datos estructurados JSON-LD: WebSite + WebPage
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE_URL}/#website`,
      url: SITE_URL,
      name: NETWORK_TITLE,
      description: NETWORK_DESCRIPTION,
      inLanguage: lang,
      publisher: {
        '@type': 'Organization',
        '@id': `${SITE_URL}/#organization`,
        name: NETWORK_TITLE,
        url: SITE_URL,
        sameAs: [NETWORK_INSTAGRAM].filter(Boolean),
      },
    },
    {
      '@type': 'WebPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description: pageOgDescription,
      inLanguage: lang,
      isPartOf: { '@id': `${SITE_URL}/#website` },
      ...(publishedTime && { datePublished: publishedTime }),
      ...(modifiedTime && { dateModified: modifiedTime }),
      ...(type === 'article' && author
        ? {
            author: {
              '@type': type === 'article' ? 'Person' : 'Organization',
              name: 'Noisk8',
            },
          }
        : {}),
    },
  ],
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content={pageOgDescription} />
<meta name="keywords" content={keywords.join(', ')} />
<meta name="author" content={author} />
<meta name="theme-color" content={THEME_COLOR} />
<meta name="robots" content={robotsContent} />
<meta name="googlebot" content={robotsContent} />

<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph -->
<meta property="og:site_name" content={NETWORK_TITLE} />
<meta property="og:title" content={pageOgTitle} />
<meta property="og:description" content={pageOgDescription} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content={lang === 'es' ? 'es_ES' : lang} />
<meta property="og:type" content={type} />
<meta property="og:image" content={resolvedImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageOgTitle} />
<meta name="twitter:description" content={pageOgDescription} />
<meta name="twitter:image" content={resolvedImage} />
{twitterHandle && <meta name="twitter:site" content={twitterHandle} />}

<!-- Artículo (Open Graph adicional) -->
{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime} />
)}
{type === 'article' && modifiedTime && (
  <meta property="article:modified_time" content={modifiedTime} />
)}
{type === 'article' && author && (
  <meta property="article:author" content={author} />
)}
{type === 'article' && section && (
  <meta property="article:section" content={section} />
)}
{tags.map((tag) => (
  <meta property="article:tag" content={tag} />
))}

<!-- Favicon / app icons -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="shortcut icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/favicon.svg" />
<link rel="manifest" href="/manifest.json" />

<!-- JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline></script>

<title>{pageTitle}</title>
