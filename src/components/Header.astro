---
const navigationItems = [
  { label: 'Acerca de', url: '/acerca-de' },
  { label: 'Simposios', url: '/simposios' },
  { label: 'Museo de Memorias Vivas', url: '/museo-memorias' },
  { label: 'Programa', url: '/programa' },
];

const pathname = Astro.url.pathname;
const isActive = (href: string) => pathname === href || pathname.startsWith(`${href}/`);
---

<header class="bg-white sticky top-0 z-50">
  <!-- Fila 1: Logos + Título centrado -->
  <div class="flex items-stretch">
    <div class="flex-1 max-w-7xl mx-auto px-4 md:px-8 py-3">
      <div class="header-brand-grid">
        <!-- Logo UGR -->
        <a
          href="https://www.ugr.es"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-shrink-0 hover:opacity-90 transition-opacity"
        >
          <img
            src="/images/logologo.png"
            alt="Universidad de Granada"
            loading="eager"
            decoding="async"
            class="!h-8 md:!h-10 lg:!h-12 w-auto !max-w-[100px] md:!max-w-[130px] lg:!max-w-[160px]"
          />
        </a>

        <a href="/" class="header-title-link">
          <h1
            class="header-title text-base md:text-lg lg:text-xl font-bold text-ugr-green leading-tight font-[family-name:var(--font-heading)] tracking-tight"
          >
            Red Internacional de Memorias Participativas
          </h1>
        </a>

        <!-- Logo EUROM -->
        <a
          href="https://eurom.ub.edu"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-shrink-0 hover:opacity-90 transition-opacity"
        >
          <img
            src="/images/logo-eurom-real.jpg"
            alt="EUROM - European Observatory on Memories"
            loading="eager"
            decoding="async"
            class="!h-8 md:!h-10 lg:!h-12 w-auto !max-w-[100px] md:!max-w-[130px] lg:!max-w-[160px]"
          />
        </a>
      </div>
    </div>
  </div>

  <!-- Fila 2: Navegación pública -->
  <div class="border-t border-gray-200">
    <div
      class="max-w-7xl mx-auto px-4 md:px-8 py-3 flex flex-col gap-3 md:flex-row md:items-center md:gap-4 lg:gap-6"
    >
      <!-- Navegación -->
      <nav class="order-3 md:order-none md:flex-1 md:min-w-0">
        <!-- Botón menú móvil -->
        <button
          id="mobile-menu-btn"
          class="md:hidden text-ugr-green p-2 rounded-lg hover:bg-ugr-green/10 transition-colors ml-auto block"
          aria-label="Menú"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>

        <!-- Navegación desktop -->
        <ul
          class="hidden md:inline-flex md:flex-wrap md:items-center md:justify-start md:gap-1 lg:gap-2"
        >
          {
            navigationItems.map((item) => (
              <li>
                <a
                  href={item.url}
                  class="nav-link"
                  aria-current={isActive(item.url) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>

        <!-- Navegación móvil -->
        <ul class="hidden md:hidden flex-col gap-1 mt-3 pb-2">
          {
            navigationItems.map((item) => (
              <li>
                <a
                  href={item.url}
                  class="nav-link-mobile"
                  aria-current={isActive(item.url) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</header>

<style>
  /* Estilos base de los enlaces de navegación */
  .nav-link,
  .nav-link-mobile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 700;
    color: #2f680c; /* ugr-green */
    text-decoration: none;
    letter-spacing: 0.01em;
    border-radius: 9999px;
    transition:
      background-color 0.2s,
      color 0.2s,
      transform 0.2s,
      box-shadow 0.2s;
  }
  .nav-link {
    padding: 0.5rem 0.8rem;
    line-height: 1;
    white-space: nowrap;
  }
  .nav-link-mobile {
    width: 100%;
    justify-content: flex-start;
    padding: 0.9rem 1rem;
    border-radius: 0.875rem;
  }

  /* Hover */
  .nav-link:hover,
  .nav-link-mobile:hover {
    background-color: rgba(47, 104, 12, 0.12);
    color: #ffffff;
    transform: translateY(-1px);
  }

  /* Página activa */
  .nav-link[aria-current='page'],
  .nav-link-mobile[aria-current='page'] {
    background-color: #2f680c;
    color: #ffffff !important;
    box-shadow: 0 8px 20px rgba(47, 104, 12, 0.18);
  }

  .nav-link[aria-current='page']:hover,
  .nav-link-mobile[aria-current='page']:hover {
    background-color: #245108;
  }

  .header-brand-grid {
    display: grid;
    align-items: center;
    gap: 0.75rem 1rem;
    grid-template-columns: auto minmax(0, 1fr) auto;
  }

  .header-title-link {
    min-width: 0;
    justify-self: center;
    text-align: center;
  }

  .header-title {
    margin: 0;
  }

  @media (max-width: 767px) {
    .header-brand-grid {
      grid-template-columns: 1fr;
      justify-items: center;
      row-gap: 0.9rem;
    }

    .header-title-link {
      order: -1;
    }
  }
</style>

<script src="../scripts/header.ts"></script>
