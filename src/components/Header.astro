---
import DynamicMenu from './DynamicMenu.astro';
---

<header class="bg-white sticky top-0 z-50">
  <!-- Fila 1: Logos + Título centrado -->
  <div class="flex items-stretch">
    <div class="flex-1 max-w-7xl mx-auto px-4 md:px-8 py-3">
      <div class="header-brand-grid">
        <!-- Logo UGR -->
        <a
          href="https://www.ugr.es"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-shrink-0 hover:opacity-90 transition-opacity"
        >
          <img
            src="/images/logologo.png"
            alt="Universidad de Granada"
            loading="eager"
            decoding="async"
            class="!h-8 md:!h-10 lg:!h-12 w-auto !max-w-[100px] md:!max-w-[130px] lg:!max-w-[160px]"
          />
        </a>

        <a href="/" class="header-title-link">
          <h1
            class="header-title text-base md:text-lg lg:text-xl font-bold text-ugr-green leading-tight font-[family-name:var(--font-heading)] tracking-tight"
          >
            Red Internacional de Memorias Participativas
          </h1>
        </a>

        <!-- Logo EUROM -->
        <a
          href="https://eurom.ub.edu"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-shrink-0 hover:opacity-90 transition-opacity"
        >
          <img
            src="/images/logo-eurom-real.jpg"
            alt="EUROM - European Observatory on Memories"
            loading="eager"
            decoding="async"
            class="!h-8 md:!h-10 lg:!h-12 w-auto !max-w-[100px] md:!max-w-[130px] lg:!max-w-[160px]"
          />
        </a>
      </div>
    </div>
  </div>

  <!-- Fila 2: Navegación + Usuario -->
  <div class="border-t border-gray-200">
    <div
      class="max-w-7xl mx-auto px-4 md:px-8 py-3 flex flex-col gap-3 md:flex-row md:items-center md:gap-4 lg:gap-6"
    >
      <!-- Navegación -->
      <nav class="order-3 md:order-none md:flex-1 md:min-w-0">
        <!-- Botón menú móvil -->
        <button
          id="mobile-menu-btn"
          class="md:hidden text-ugr-green p-2 rounded-lg hover:bg-ugr-green/10 transition-colors ml-auto block"
          aria-label="Menú"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>

        <!-- Navegación desktop -->
        <DynamicMenu
          slug="principal"
          class="hidden md:inline-flex md:flex-wrap md:items-center md:justify-start md:gap-1 lg:gap-2"
          itemClass="nav-link"
        />

        <!-- Navegación móvil -->
        <DynamicMenu
          slug="principal"
          class="hidden md:hidden flex-col gap-1 mt-3 pb-2"
          itemClass="nav-link-mobile"
          mobile
        />
      </nav>

      <!-- Usuario -->
      <div
        class="flex items-center gap-2 flex-shrink-0 order-2 md:order-none md:ml-auto md:justify-end"
      >
        <!-- Estado: autenticado — dropdown hover -->
        <div id="user-info" class="hidden relative group">
          <!-- Trigger: avatar + nombre -->
          <button
            id="user-trigger"
            class="flex items-center gap-2 cursor-pointer rounded-lg px-1 py-1 hover:bg-gray-100 transition-colors"
            aria-haspopup="true"
            aria-expanded="false"
          >
            <div
              class="w-8 h-8 rounded-full bg-ugr-green text-white flex items-center justify-center flex-shrink-0"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M10 9a3 3 0 100-6 3 3 0 000 6zm-7 9a7 7 0 1114 0H3z"
                  clip-rule="evenodd"></path>
              </svg>
            </div>
            <span
              id="user-name"
              class="text-sm font-medium text-ugr-text max-w-[140px] truncate hidden md:block"
            ></span>
            <!-- chevron pequeño -->
            <svg
              class="w-3 h-3 text-gray-400 hidden md:block"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path>
            </svg>
          </button>

          <!-- Dropdown (visible en hover desktop / toggle click móvil) -->
          <div
            id="user-dropdown"
            class="absolute right-0 top-full mt-1 w-36 bg-white border border-gray-200 rounded-lg shadow-lg py-1 z-50
                   opacity-0 invisible pointer-events-none
                   group-hover:opacity-100 group-hover:visible group-hover:pointer-events-auto
                   transition-all duration-150"
          >
            <a
              id="admin-link"
              href="/admin/"
              class="hidden w-full text-left px-4 py-2 text-sm font-semibold text-ugr-green hover:bg-ugr-green hover:text-white transition-colors"
            >
              Admin
            </a>
            <button
              id="logout-btn"
              class="w-full text-left px-4 py-2 text-sm font-semibold text-ugr-green hover:bg-ugr-green hover:text-white transition-colors"
            >
              Salir
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  /* Estilos base de los enlaces de navegación */
  .nav-link,
  .nav-link-mobile {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    font-weight: 700;
    color: #2f680c; /* ugr-green */
    text-decoration: none;
    letter-spacing: 0.01em;
    border-radius: 9999px;
    transition:
      background-color 0.2s,
      color 0.2s,
      transform 0.2s,
      box-shadow 0.2s;
  }
  .nav-link {
    padding: 0.5rem 0.8rem;
    line-height: 1;
    white-space: nowrap;
  }
  .nav-link-mobile {
    width: 100%;
    justify-content: flex-start;
    padding: 0.9rem 1rem;
    border-radius: 0.875rem;
  }

  /* Hover */
  .nav-link:hover,
  .nav-link-mobile:hover {
    background-color: rgba(47, 104, 12, 0.12);
    color: #ffffff;
    transform: translateY(-1px);
  }

  /* Página activa */
  .nav-link[aria-current='page'],
  .nav-link-mobile[aria-current='page'] {
    background-color: #2f680c;
    color: #ffffff !important;
    box-shadow: 0 8px 20px rgba(47, 104, 12, 0.18);
  }

  .nav-link[aria-current='page']:hover,
  .nav-link-mobile[aria-current='page']:hover {
    background-color: #245108;
  }

  .header-brand-grid {
    display: grid;
    align-items: center;
    gap: 0.75rem 1rem;
    grid-template-columns: auto minmax(0, 1fr) auto;
  }

  .header-title-link {
    min-width: 0;
    justify-self: center;
    text-align: center;
  }

  .header-title {
    margin: 0;
  }

  @media (max-width: 767px) {
    .header-brand-grid {
      grid-template-columns: 1fr;
      justify-items: center;
      row-gap: 0.9rem;
    }

    .header-title-link {
      order: -1;
    }
  }

  /* Puente invisible para no perder el hover en el gap del dropdown */
  #user-dropdown::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 0;
    right: 0;
    height: 8px;
    background: transparent;
  }
</style>

<script>
  // @ts-nocheck
  import { getSupabaseBrowserClient } from '../lib/supabase-browser.ts';

  const btn = document.getElementById('mobile-menu-btn');
  const nav =
    btn?.closest('nav')?.querySelector('.md\\:hidden.flex-col') ||
    document.querySelector('nav .md\\:hidden');
  btn?.addEventListener('click', () => {
    nav?.classList.toggle('hidden');
  });

  const userInfo = document.getElementById('user-info');
  const userName = document.getElementById('user-name');
  const adminLink = document.getElementById('admin-link');
  const logoutBtn = document.getElementById('logout-btn');
  const userTrigger = document.getElementById('user-trigger');
  const userDropdown = document.getElementById('user-dropdown');

  function isTypingTarget(target) {
    if (!(target instanceof HTMLElement)) return false;
    return Boolean(
      target.isContentEditable ||
      ['INPUT', 'TEXTAREA', 'SELECT'].includes(target.tagName) ||
      target.closest('[contenteditable="true"]')
    );
  }

  function setDropdownOpen(open) {
    if (open) {
      userDropdown?.classList.add('!opacity-100', '!visible', '!pointer-events-auto');
    } else {
      userDropdown?.classList.remove('!opacity-100', '!visible', '!pointer-events-auto');
    }
    userTrigger?.setAttribute('aria-expanded', open ? 'true' : 'false');
  }

  userTrigger?.addEventListener('click', () => {
    const isOpen = userDropdown?.classList.contains('!opacity-100');
    setDropdownOpen(!isOpen);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setDropdownOpen(false);
    if (
      e.ctrlKey &&
      e.altKey &&
      !e.metaKey &&
      !e.shiftKey &&
      String(e.key).toLowerCase() === 'y' &&
      !isTypingTarget(e.target)
    ) {
      e.preventDefault();
      window.location.assign('/admin/login');
    }
  });

  // Cerrar dropdown al hacer click fuera
  document.addEventListener('click', (e) => {
    if (!userInfo?.contains(e.target)) {
      setDropdownOpen(false);
    }
  });

  function updateUserUI(user) {
    if (user && userName) {
      const metadata = user.user_metadata || user.app_metadata || {};
      const displayName = metadata.full_name || metadata.name || user.email;
      userName.textContent = displayName;
      userInfo?.classList.remove('hidden');
      adminLink?.classList.remove('hidden');
      adminLink?.classList.add('block');
    } else {
      userInfo?.classList.add('hidden');
      adminLink?.classList.add('hidden');
      adminLink?.classList.remove('block');
    }
  }

  async function setupSupabase() {
    const supabase = getSupabaseBrowserClient();
    if (!supabase) {
      updateUserUI(null);
      return;
    }

    const session = (await supabase.auth.getSession()).data.session;
    updateUserUI(session?.user || null);
    supabase.auth.onAuthStateChange((_event, nextSession) => {
      updateUserUI(nextSession?.user || null);
    });

    logoutBtn?.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.assign('/');
    });
  }

  setupSupabase();
</script>
