<svg
  class="home-vector"
  viewBox="0 0 1200 4800"
  preserveAspectRatio="none"
  fill="none"
  aria-hidden="true"
  focusable="false"
  data-home-vector
>
  <defs>
    <linearGradient id="home-thread-gradient" x1="0" y1="0" x2="0.8" y2="1">
      <stop stop-color="#89ad6a"></stop>
      <stop offset="0.5" stop-color="#2f680c"></stop>
      <stop offset="1" stop-color="#1e4a08"></stop>
    </linearGradient>
  </defs>
  <path data-vector-path class="home-vector-line" vector-effect="non-scaling-stroke"></path>
  <circle data-vector-tip cx="0" cy="0" r="9" fill="#1e4a08" opacity="0"></circle>
</svg>
