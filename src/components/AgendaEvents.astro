---
import { getCollection } from 'astro:content';
import { filterPublished } from '../lib/taxonomies';
import { resolvePublicImageUrl } from '../lib/public-image';
import { formatEventDate, groupEvents } from '../../shared/content/events';

const events = filterPublished(await getCollection('eventos'));
const { upcoming, past } = groupEvents(events);
const groups = [
  { title: 'Próximos eventos', events: upcoming },
  { title: 'Eventos anteriores', events: past },
];
---

<section class="py-12 bg-ugr-cream" aria-label="Eventos de la Red">
  <div class="max-w-6xl mx-auto px-4 space-y-12">
    {
      groups.map((group) => (
        <div>
          <h2 class="text-2xl md:text-3xl font-bold text-ugr-green-dark mb-6 font-[family-name:var(--font-heading)]">
            {group.title}
          </h2>
          {group.events.length ? (
            <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
              {group.events.map((event) => (
                <article class="card-shadow bg-white rounded-xl overflow-hidden flex flex-col">
                  <img
                    src={resolvePublicImageUrl(event.data.image)}
                    alt={event.data.title}
                    class="w-full aspect-[4/3] object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                  <div class="p-6 flex flex-col flex-1">
                    <time datetime={event.data.date} class="text-sm font-semibold text-ugr-green">
                      {formatEventDate(event.data.date)}
                    </time>
                    <h3 class="text-xl font-bold text-ugr-green-dark mt-2 mb-3">
                      <a href={`/agenda/${event.id}/`} class="hover:underline">
                        {event.data.title}
                      </a>
                    </h3>
                    <p class="text-ugr-text-light mb-5 whitespace-pre-line">
                      {event.data.description}
                    </p>
                    <dl class="mt-auto text-sm space-y-3 text-ugr-text">
                      <div>
                        <dt class="font-semibold">Dirección</dt>
                        <dd>{event.data.address}</dd>
                      </div>
                      <div>
                        <dt class="font-semibold">Organiza</dt>
                        <dd>{event.data.organizer}</dd>
                      </div>
                    </dl>
                    <a
                      href={`/agenda/${event.id}/`}
                      class="text-ugr-green font-semibold mt-5 hover:underline"
                    >
                      Ver evento<span class="sr-only">: {event.data.title}</span> →
                    </a>
                  </div>
                </article>
              ))}
            </div>
          ) : (
            <p class="rounded-xl bg-white p-6 text-ugr-text-light">
              {group.title === 'Próximos eventos'
                ? 'Pronto compartiremos nuevos eventos y actividades de la Red.'
                : 'Aquí podrás consultar los eventos anteriores de la Red cuando estén publicados.'}
            </p>
          )}
        </div>
      ))
    }
  </div>
</section>
