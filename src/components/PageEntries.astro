---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/taxonomies';
import { resolvePublicImageUrl } from '../lib/public-image';

interface Props {
  entries: CollectionEntry<'entradas'>[];
}

const { entries } = Astro.props;
---

{
  entries.length > 0 && (
    <section
      class="border-t border-gray-100 bg-ugr-cream py-16"
      aria-labelledby="page-entries-title"
    >
      <div class="mx-auto max-w-5xl px-4">
        <div class="mb-8 max-w-2xl">
          <p class="mb-2 text-sm font-bold uppercase tracking-wider text-ugr-green">
            Contenido relacionado
          </p>
          <h2
            id="page-entries-title"
            class="text-3xl font-bold text-ugr-green-dark font-[family-name:var(--font-heading)]"
          >
            Entradas de esta página
          </h2>
        </div>
        <div class="grid gap-7 md:grid-cols-2 lg:grid-cols-3">
          {entries.map((entry) => (
            <article class="group overflow-hidden rounded-xl border border-gray-100 bg-white shadow-sm transition-all duration-300 hover:border-ugr-green/30 hover:shadow-md">
              {entry.data.image && (
                <a href={`/entradas/${entry.id}`} class="block h-44 overflow-hidden">
                  <img
                    src={resolvePublicImageUrl(entry.data.image)}
                    alt=""
                    class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              )}
              <div class="p-5">
                {entry.data.date && (
                  <p class="mb-1 text-xs font-semibold uppercase tracking-wide text-ugr-green-light">
                    {formatDate(entry.data.date)}
                  </p>
                )}
                <h3 class="font-[family-name:var(--font-heading)] text-lg font-bold text-ugr-green-dark">
                  <a href={`/entradas/${entry.id}`} class="transition-colors hover:text-ugr-green">
                    {entry.data.title}
                  </a>
                </h3>
                {entry.data.description && (
                  <p class="mt-3 line-clamp-3 text-sm text-ugr-text-light">
                    {entry.data.description}
                  </p>
                )}
                <a
                  href={`/entradas/${entry.id}`}
                  class="mt-4 inline-block text-xs font-semibold uppercase tracking-wide text-ugr-green hover:underline"
                >
                  Leer entrada →
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )
}
