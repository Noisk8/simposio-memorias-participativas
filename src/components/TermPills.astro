---
interface Props {
  categories?: string[];
  tags?: string[];
  catTitles: Map<string, string>;
  tagTitles: Map<string, string>;
  size?: 'sm' | 'md';
}

const { categories = [], tags = [], catTitles, tagTitles, size = 'md' } = Astro.props;
const sizeClasses = size === 'sm' ? 'text-[10px] px-2 py-0.5' : 'text-xs px-3 py-1';
---

{
  (categories.length > 0 || tags.length > 0) && (
    <div class={`flex flex-wrap ${size === 'sm' ? 'gap-1' : 'gap-2'}`}>
      {categories.map((slug) => {
        const title = catTitles.get(slug) || slug;
        return (
          <a
            href={`/categorias/${slug}/`}
            class={`${sizeClasses} uppercase tracking-wider font-semibold bg-ugr-green/10 text-ugr-green rounded-full hover:bg-ugr-green hover:text-white transition-colors`}
          >
            {title}
          </a>
        );
      })}
      {tags.map((slug) => {
        const title = tagTitles.get(slug) || slug;
        return (
          <a
            href={`/etiquetas/${slug}/`}
            class={`${sizeClasses} uppercase tracking-wider font-semibold bg-gray-100 text-ugr-text-light rounded-full hover:bg-gray-600 hover:text-white transition-colors`}
          >
            #{title}
          </a>
        );
      })}
    </div>
  )
}
