---
/**
 * Pills clicables de categorías y etiquetas (estilo WordPress).
 * Enlazan a las páginas de archivo /categorias/[slug] y /etiquetas/[slug].
 */
interface Props {
  categories?: string[];
  tags?: string[];
  catSlugs: Map<string, string>;
  tagSlugs: Map<string, string>;
  size?: 'sm' | 'md';
}

import { resolveTermSlug } from '../lib/taxonomies';

const { categories = [], tags = [], catSlugs, tagSlugs, size = 'md' } = Astro.props;
const sizeClasses = size === 'sm'
  ? 'text-[10px] px-2 py-0.5'
  : 'text-xs px-3 py-1';
---

{(categories.length > 0 || tags.length > 0) && (
  <div class={`flex flex-wrap ${size === 'sm' ? 'gap-1' : 'gap-2'}`}>
    {categories.map((cat) => (
      <a
        href={`/categorias/${resolveTermSlug(cat, catSlugs)}/`}
        class={`${sizeClasses} uppercase tracking-wider font-semibold bg-ugr-green/10 text-ugr-green rounded-full hover:bg-ugr-green hover:text-white transition-colors`}
      >
        {cat}
      </a>
    ))}
    {tags.map((tag) => (
      <a
        href={`/etiquetas/${resolveTermSlug(tag, tagSlugs)}/`}
        class={`${sizeClasses} uppercase tracking-wider font-semibold bg-gray-100 text-ugr-text-light rounded-full hover:bg-gray-600 hover:text-white transition-colors`}
      >
        #{tag}
      </a>
    ))}
  </div>
)}
