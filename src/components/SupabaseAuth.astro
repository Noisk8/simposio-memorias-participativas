---
interface Props {
  intro?: string;
  redirectUnauthenticated?: boolean;
  redirectAfterLogin?: string;
}

const {
  intro = 'Inicia sesión con tu cuenta del simposio para acceder al panel.',
  redirectUnauthenticated = false,
  redirectAfterLogin = '',
} = Astro.props;

Astro.csp?.insertDirective("connect-src 'self' https://*.supabase.co");
---

<div
  id="supabase-auth"
  class="hidden"
  data-redirect-unauthenticated={String(redirectUnauthenticated)}
  data-redirect-after-login={redirectAfterLogin}
>
  <div class="max-w-md mx-auto p-6 bg-white border border-gray-200 rounded-xl shadow-sm">
    <h2 class="text-lg font-semibold text-ugr-text mb-2">Iniciar sesión</h2>
    <p class="text-sm text-ugr-text-light mb-4">{intro}</p>
    <form id="supabase-login-form" class="space-y-4">
      <div>
        <label class="block text-sm font-semibold text-ugr-text mb-1" for="supabase-email"
          >Email</label
        >
        <input
          type="email"
          id="supabase-email"
          required
          autocomplete="email"
          class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green"
        />
      </div>
      <div>
        <label class="block text-sm font-semibold text-ugr-text mb-1" for="supabase-password"
          >Contraseña</label
        >
        <input
          type="password"
          id="supabase-password"
          required
          autocomplete="current-password"
          class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green"
        />
      </div>
      <button type="submit" class="btn-green w-full">Entrar</button>
      <p id="supabase-login-error" class="hidden text-sm text-red-600"></p>
    </form>
  </div>
</div>

<p id="supabase-user-info" class="hidden text-sm text-ugr-text-light mb-4"></p>
<button id="supabase-signout" class="hidden text-sm text-ugr-green hover:underline font-medium"
  >Cerrar sesión</button
>

<script src="../scripts/admin/auth.ts"></script>
