---
import { NETWORK_EMAIL, NETWORK_INSTAGRAM } from '../consts';
---

<footer class="footer-shell text-white mt-auto">
  <div class="max-w-6xl mx-auto px-4 py-5 md:py-6">
    <div class="footer-grid">
      <section class="footer-brand">
        <p class="footer-kicker">Red Internacional de Memorias Participativas</p>
        <p class="footer-copy">
          Una red para compartir memoria, investigación y colaboración entre instituciones y
          comunidades.
        </p>
      </section>

      <section>
        <p class="footer-label">Contacto</p>
        <div class="footer-links">
          <a href="/contacto">Formulario</a>
          <a href={`mailto:${NETWORK_EMAIL}`}>{NETWORK_EMAIL}</a>
          <a href={NETWORK_INSTAGRAM} target="_blank" rel="noopener noreferrer"> Instagram </a>
        </div>
      </section>

      <section>
        <p class="footer-label">Enlaces</p>
        <div class="footer-links">
          <a href="http://www.ugr.es" target="_blank" rel="noopener noreferrer"> UGR </a>
          <a href="https://blogs.ugr.es" target="_blank" rel="noopener noreferrer"> blogsUGR </a>
          <a href="http://csirc.ugr.es/" target="_blank" rel="noopener noreferrer"> C.S.I.R.C. </a>
        </div>
      </section>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="max-w-6xl mx-auto px-4 py-3">
      <div
        class="flex flex-col gap-1 text-xs text-white/50 md:flex-row md:items-center md:justify-between"
      >
        <p>&copy; 2026 Red Internacional de Memorias Participativas</p>
        <a
          href="https://blogs.ugr.es/plataformas-webs-corporativas"
          target="_blank"
          rel="noopener noreferrer"
          class="footer-bottom-link"
        >
          Plataformas webs corporativas
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-shell {
    background:
      radial-gradient(circle at top left, rgba(255, 255, 255, 0.06), transparent 35%),
      linear-gradient(180deg, #295b0b 0%, #214907 100%);
  }

  .footer-grid {
    display: grid;
    gap: 1.25rem;
    align-items: start;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(0, 0.8fr));
      gap: 1.5rem;
    }
  }

  .footer-brand {
    max-width: 34rem;
  }

  .footer-kicker {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: 0.01em;
  }

  .footer-label {
    margin: 0 0 0.55rem;
    color: rgba(255, 255, 255, 0.58);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .footer-copy {
    margin: 0.45rem 0 0;
    color: rgba(255, 255, 255, 0.72);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 0.9rem;
    font-size: 0.9rem;
  }

  .footer-links a,
  .footer-bottom-link {
    color: rgba(255, 255, 255, 0.82);
    transition:
      color 0.2s ease,
      opacity 0.2s ease;
  }

  .footer-links a:hover,
  .footer-bottom-link:hover {
    color: #fff;
  }

  .footer-bottom {
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(0, 0, 0, 0.05);
  }
</style>
