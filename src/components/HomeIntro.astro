---
interface Props {
  title: string;
  place: string;
  image: string;
}

const { title, place, image } = Astro.props;
const videoUrl = 'https://cms-media.web.red-memorias.duckdns.org/Videos/simposio.webm';
// Selección del I Simposio: diálogo, creación colectiva, exposiciones y encuentro.
const trailImages = [
  // Diálogo en la inauguración · IMG_3597.jpg
  'https://cms-media.web.red-memorias.duckdns.org/images/2026/10/490a03c8-2900-4d11-bd81-79ff52f1959e-img_3597.webp',
  // Intercambio en grupo · _FFF2298.jpg
  'https://cms-media.web.red-memorias.duckdns.org/images/2026/10/7af1aaad-8223-4a1f-ab0f-9cd502117a76-fff2298.webp',
  // Memorias textiles · _FFF2246.jpg
  'https://cms-media.web.red-memorias.duckdns.org/images/2026/10/b420a196-04a8-49dd-ac58-97bd91aacecf-fff2246.webp',
  // Encuentro al atardecer · _FFF2363.jpg
  'https://cms-media.web.red-memorias.duckdns.org/images/2026/10/0c80cbda-b8ca-4d65-ba01-93239c077557-fff2363.webp',
  // Memoria y realidad virtual · Imagen(2)2.jpg
  'https://cms-media.web.red-memorias.duckdns.org/images/2026/10/2b0a7508-46fa-484d-858a-8d2bca1946af-imagen-2-2.webp',
  // Construcción colectiva · _FFF2282.jpg
  'https://cms-media.web.red-memorias.duckdns.org/images/2026/10/5d2fab7c-4416-40b9-a865-f80c06d57f2f-fff2282.webp',
  // Creación escénica · _FFF2442.jpg
  'https://cms-media.web.red-memorias.duckdns.org/images/2026/10/253c7a39-9e6d-4fa5-8c03-a027ca10a0c1-fff2442.webp',
  // Escucha entre participantes · _FFF2327.jpg
  'https://cms-media.web.red-memorias.duckdns.org/images/2026/10/0eebc5b0-160b-466a-9d56-bf1d4c96d81f-fff2327.webp',
];
---

<section class="home-hero" data-home-hero>
  <div class="home-hero-media" aria-hidden="true">
    <video src={videoUrl} poster={image} muted loop playsinline preload="none" data-hero-video
    ></video>
  </div>
  <div class="home-hero-shade" aria-hidden="true"></div>
  <div
    class="home-hero-trail"
    data-hero-trail
    data-trail-images={JSON.stringify(trailImages)}
    aria-hidden="true"
  >
  </div>
  <div class="home-hero-copy">
    <p class="home-eyebrow">Encuentros, territorios y comunidad</p>
    <h1>{title.toUpperCase()}</h1>
    <p class="home-hero-place">Experiencias que conectan colectivos, agentes y comunidades.</p>
    <a href="/acerca-de" class="home-hero-cta">
      Conoce la Red
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M5 12h14m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5"></path>
      </svg>
    </a>
  </div>
  <div class="home-hero-bottom">
    <a class="home-scroll-cue" href="#videoresumen">
      <span>Desplázate para descubrir</span>
      <svg width="20" height="26" viewBox="0 0 20 26" fill="none" aria-hidden="true">
        <path d="M10 1v23m-7-7 7 7 7-7" stroke="currentColor" stroke-width="1.5"></path>
      </svg>
    </a>
    <button class="home-media-toggle" type="button" data-hero-toggle hidden> Pausar fondo </button>
  </div>
</section>

<script>
  import '../scripts/hero-image-trail';
</script>

<section id="videoresumen" class="home-reel" aria-labelledby="home-reel-title">
  <div class="home-reel-intro" data-reel-intro data-vector-section="intro">
    <div class="home-reel-copy" data-reveal-anchor>
      <p class="home-eyebrow" data-home-reveal>El encuentro, en imágenes</p>
      <h2 id="home-reel-title" data-home-reveal data-reveal-kind="words">
        Memorias que<br />nos conectan.
      </h2>
      <p class="home-reel-description" data-home-reveal>
        Revive el simposio y las experiencias que compartimos.
      </p>
      <a
        href="/museo-memorias"
        class="home-reel-cta btn-green"
        data-home-reveal
        data-reveal-kind="cta"
      >
        Explora el Museo de Memorias Vivas →
      </a>
    </div>
    <span class="home-reel-index" aria-hidden="true">01 / VIDEORESUMEN</span>
  </div>

  <div class="home-video-stage" data-video-stage data-vector-section="video">
    <div class="home-video-sticky">
      <div class="home-video-frame" data-video-frame>
        <div class="home-video-markers" aria-hidden="true">
          <span>+</span><span>+</span><span>+</span>
        </div>
        <div class="home-video-mask">
          <video
            src={videoUrl}
            poster={image}
            aria-label="Videoresumen del simposio"
            muted
            playsinline
            controls
            preload="none"
            data-reel-video></video>
        </div>
        <div class="home-video-caption" data-reveal-anchor>
          <span data-home-reveal>Videoresumen del simposio</span><span data-home-reveal
            >{place}</span
          >
        </div>
      </div>
    </div>
  </div>
</section>
