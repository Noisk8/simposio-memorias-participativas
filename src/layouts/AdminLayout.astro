---
import Seo from '../components/Seo.astro';
import { Font } from 'astro:assets';
import '../styles/global.css';
interface Props {
  title?: string;
}
const { title = 'CMS · Red de Memorias' } = Astro.props;
const githubRepo = String(
  import.meta.env.GITHUB_REPO || 'Noisk8/simposio-memorias-participativas'
).replace(/\.git$/i, '');
const githubBranch = String(import.meta.env.GITHUB_BRANCH || 'main').trim() || 'main';
const mediaPreviewBase = `https://raw.githubusercontent.com/${githubRepo}/${githubBranch}/public/images/`;

// Debe registrarse antes de renderizar el <head>; hacerlo desde un componente
// situado en el <slot> llega demasiado tarde para la CSP generada por Astro.
Astro.csp?.insertDirective("connect-src 'self' https://*.supabase.co");
---

<!doctype html>
<html lang="es" data-admin-theme="light">
  <head>
    <Font cssVariable="--font-montserrat" />
    <Seo title={title} noindex />
  </head>
  <body class="cms-body" data-pagefind-ignore="all" data-media-preview-base={mediaPreviewBase}>
    <header class="cms-topbar">
      <a class="cms-brand" href="/admin/"><span>◉</span> Red de Memorias</a>
      <nav class="cms-topnav" aria-label="Navegación principal del CMS">
        <a href="/admin/">⌂ <span>Inicio</span></a>
        <a href="/admin/contenidos?collection=entradas">▣ <span>Entradas</span></a>
        <a href="/admin/contenidos?collection=memorias">▦ <span>Memorias</span></a>
        <a href="/admin/contenidos?collection=paginas">▤ <span>Páginas</span></a>
      </nav>
      <div class="cms-top-actions">
        <button id="cms-theme" type="button">☀ <span>Tema</span></button>
        <div class="cms-account-wrap">
          <button id="cms-account" type="button" aria-haspopup="true" aria-expanded="false"
            ><span id="cms-avatar" class="cms-avatar">N</span><span id="cms-user-name">Usuario</span
            ><span id="cms-account-arrow">⌄</span></button
          >
          <div id="cms-account-menu" class="cms-account-menu hidden" role="menu">
            <a href="/admin/" role="menuitem"><span>⌂</span> Inicio</a>
            <a href="/admin/?tour=1" role="menuitem"><span>◷</span> <strong>Guía de uso</strong></a>
            <button id="cms-menu-signout" type="button" role="menuitem"
              ><span>→|</span> <strong>Cerrar sesión</strong></button
            >
          </div>
        </div>
      </div>
    </header>
    <main class="cms-main"><slot /></main>
    <script src="../scripts/admin/layout.ts"></script>
  </body>
</html>

<style is:global>
  :root {
    --cms-bg: #f0f0f1;
    --cms-panel: #fff;
    --cms-text: #182230;
    --cms-muted: #667085;
    --cms-border: #d0d5dd;
    --cms-blue: #287bb8;
    --cms-side: #f8fafc;
  }
  :root[data-admin-theme='dark'] {
    --cms-bg: #111827;
    --cms-panel: #1f2937;
    --cms-text: #f8fafc;
    --cms-muted: #cbd5e1;
    --cms-border: #475569;
    --cms-side: #172033;
  }
  .cms-body {
    margin: 0;
    background: var(--cms-bg);
    color: var(--cms-text);
    font-family: var(--font-montserrat), sans-serif;
    min-height: 100vh;
    font-size: 16px;
    line-height: 1.4;
  }
  .cms-main {
    padding: 0 !important;
  }
  .cms-topbar {
    height: 54px;
    box-sizing: border-box;
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    border-top: 2px solid #17202c;
    background: var(--cms-side);
    box-shadow: 0 1px 2px #00000012;
    padding: 0 16px;
    gap: 28px;
  }
  .cms-brand {
    font-size: 20px;
    font-weight: 700;
    color: var(--cms-text) !important;
    white-space: nowrap;
  }
  .cms-topnav {
    display: flex;
    align-items: stretch;
    height: 100%;
    gap: 28px;
  }
  .cms-topnav a,
  .cms-top-actions button {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--cms-text) !important;
    font-weight: 600;
    background: none;
    border: 0;
    font-size: 16px;
    cursor: pointer;
  }
  .cms-top-actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 18px;
    height: 100%;
  }
  .cms-account {
    background: var(--cms-blue);
  }
  .cms-account-wrap {
    position: relative;
  }
  .cms-account-menu {
    position: absolute;
    right: 0;
    top: 52px;
    width: 190px;
    box-sizing: border-box;
    padding: 10px;
    background: var(--cms-panel);
    border: 1px solid var(--cms-border);
    border-radius: 14px;
    box-shadow: 0 18px 38px #10182825;
  }
  .cms-account-menu.hidden {
    display: none;
  }
  .cms-account-menu a,
  .cms-account-menu button {
    display: flex !important;
    width: 100%;
    box-sizing: border-box;
    align-items: center;
    gap: 11px;
    padding: 10px 9px !important;
    border-radius: 8px !important;
    background: transparent !important;
    color: var(--cms-text) !important;
    text-align: left;
    text-decoration: none;
    font: inherit;
  }
  .cms-account-menu a:hover,
  .cms-account-menu button:hover {
    background: var(--cms-bg) !important;
  }
  .cms-account-menu span {
    width: 18px;
    color: var(--cms-muted);
  }
  #cms-account {
    height: 44px;
    padding: 0 14px;
    border-radius: 11px;
    background: var(--cms-blue);
    color: white !important;
    gap: 10px;
  }
  .cms-avatar {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #ffffff12;
  }
  @media (max-width: 760px) {
    .cms-topnav span,
    .cms-top-actions button > span:not(.cms-avatar) {
      display: none;
    }
    .cms-topbar {
      gap: 14px;
    }
    .cms-topnav {
      gap: 12px;
    }
    .cms-brand {
      font-size: 17px;
    }
  }
</style>
