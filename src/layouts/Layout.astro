---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo from '../components/Seo.astro';
import '../styles/global.css';
import { NETWORK_DESCRIPTION } from '../consts';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  type?: 'website' | 'article' | 'event';
  canonical?: string;
  publishDate?: Date | string;
  modifiedDate?: Date | string;
  tags?: string[];
}

const { title, description = NETWORK_DESCRIPTION, image, noindex, type, canonical, publishDate, modifiedDate, tags } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <Seo
      title={title}
      description={description}
      image={image}
      noindex={noindex}
      type={type}
      canonical={canonical}
      publishDate={publishDate}
      modifiedDate={modifiedDate}
      tags={tags}
    />
    <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      if (window.netlifyIdentity) {
        window.netlifyIdentity.on('init', (user) => {
          const hash = window.location.hash;
          // Si hay token de invitación o recuperación, abrir el modal para que
          // el widget complete la aceptación de la invitación o el reseteo.
          if (hash && (hash.includes('invite_token=') || hash.includes('recovery_token='))) {
            window.netlifyIdentity.open();
            return;
          }
          // Si no hay sesión activa, al hacer login redirigir al admin
          if (!user) {
            window.netlifyIdentity.on('login', () => {
              document.location.href = '/admin/';
            });
          }
        });
      }
    </script>
  </body>
</html>
