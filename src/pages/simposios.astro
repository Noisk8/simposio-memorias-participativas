---
import Layout from '../layouts/Layout.astro';
import { getSimposios } from '../lib/simposios';

const simposios = await getSimposios();
const ordenados = simposios.sort((a, b) => b.data.year - a.data.year);
---

<Layout
  title="Simposios · Red Internacional de Memorias Participativas"
  description="Ediciones del simposio de la Red Internacional de Memorias Participativas."
>
  <!-- Hero -->
  <section class="relative h-[40vh] min-h-[300px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/hero-bg.jpg"
        alt="Simposios de la Red Internacional de Memorias Participativas"
        class="w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 bg-black/60"></div>
    </div>
    <div class="relative z-10 text-center px-4">
      <nav class="text-white/70 text-sm mb-4">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <span class="mx-2">/</span>
        <span class="text-white">Simposios</span>
      </nav>
      <h1
        class="text-4xl md:text-5xl font-bold text-white font-[family-name:var(--font-heading)] drop-shadow-lg"
      >
        Simposios
      </h1>
    </div>
  </section>

  <!-- Listado de ediciones -->
  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4">
      {
        ordenados.length === 0 && (
          <p class="text-center text-ugr-text-light py-16">No hay simposios publicados todavía.</p>
        )
      }
      <div class="grid gap-8 md:grid-cols-2">
        {
          ordenados.map((simposio) => (
            <a
              href={`/ediciones/${simposio.data.slug}/`}
              class="card-shadow bg-white rounded-xl overflow-hidden border border-gray-100 hover:border-ugr-green transition-all duration-300 group"
            >
              <div class="relative h-56 overflow-hidden">
                <img
                  src={simposio.data.image || '/images/hero-bg.jpg'}
                  alt={simposio.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute top-4 left-4">
                  <span
                    class={`text-xs font-bold px-3 py-1 rounded-full uppercase tracking-wide ${
                      simposio.data.status === 'active'
                        ? 'bg-ugr-green text-white'
                        : simposio.data.status === 'upcoming'
                          ? 'bg-yellow-500 text-white'
                          : 'bg-gray-200 text-ugr-text'
                    }`}
                  >
                    {simposio.data.status === 'active'
                      ? 'Activo'
                      : simposio.data.status === 'upcoming'
                        ? 'Próximo'
                        : 'Archivado'}
                  </span>
                </div>
              </div>
              <div class="p-6">
                <p class="text-sm text-ugr-green-light font-semibold uppercase tracking-wide mb-1">
                  {simposio.data.year} · {simposio.data.place}
                </p>
                <h2 class="text-2xl font-bold text-ugr-green-dark mb-3 font-[family-name:var(--font-heading)] group-hover:text-ugr-green transition-colors">
                  {simposio.data.title}
                </h2>
                {simposio.data.theme && <p class="text-ugr-text mb-4">{simposio.data.theme}</p>}
                <span class="text-sm font-semibold text-ugr-green uppercase tracking-wide">
                  Ver edición →
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
