---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Buscar - Red Internacional de Memorias Participativas">
  <section class="max-w-4xl mx-auto px-4 md:px-8 py-12">
    <h1
      class="text-2xl md:text-3xl font-bold text-ugr-green-dark mb-6 font-[family-name:var(--font-heading)]"
    >
      Buscar contenidos
    </h1>
    <div id="pagefind-ui" class="w-full"></div>
  </section>
</Layout>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script src="/pagefind/pagefind-ui.js" is:inline></script>
<script is:inline>
  /* global PagefindUI */
  window.addEventListener('DOMContentLoaded', function () {
    if (typeof PagefindUI !== 'undefined') {
      new PagefindUI({
        element: '#pagefind-ui',
        showSubResults: true,
        showImages: true,
        translations: {
          placeholder: 'Buscar entradas, memorias, páginas...',
          zero_results: 'No se encontraron resultados para "{query}".',
          clear_search: 'Limpiar',
          load_more: 'Cargar más resultados',
          search_label: 'Buscar en este sitio',
          results_title: 'Resultados para "{query}"',
        },
      });
    }
  });
</script>

<style is:global>
  :root {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: #2f680c;
    --pagefind-ui-text: #333333;
    --pagefind-ui-background: #ffffff;
    --pagefind-ui-border: #e5e7eb;
    --pagefind-ui-tag: #f3f4f6;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 0.5rem;
    --pagefind-ui-image-border-radius: 0.375rem;
    --pagefind-ui-image-box-ratio: 3 / 2;
    --pagefind-ui-font: var(--font-montserrat), sans-serif;
  }
</style>
