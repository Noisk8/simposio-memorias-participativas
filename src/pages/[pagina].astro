---
import Layout from '../layouts/Layout.astro';
import PageTemplate from '../components/PageTemplate.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { getSimposioDefault } from '../lib/simposios';
import { filterPublished, sortByDateDesc } from '../lib/taxonomies';
import { entryBelongsToPage } from '../../shared/content/page-relations';

interface Props {
  entry: CollectionEntry<'paginas'>;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const paginas = filterPublished(await getCollection('paginas'));
  const defaultSimposio = await getSimposioDefault();
  return paginas
    .filter((entry) => entry.data.simposio === defaultSimposio?.data.slug)
    .map((entry) => ({
      params: { pagina: entry.data.slug || entry.data.template },
      props: { entry },
    }));
};

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const simposio = await getSimposioDefault();
const simposioTitle = simposio?.data.title || 'I Simposio sobre Memorias Participativas';
const entries = filterPublished(await getCollection('entradas')).filter((item) =>
  entryBelongsToPage(item, entry)
);
sortByDateDesc(entries);

const pageTitle = `${data.title} - ${simposioTitle}`;
const heroImage = data.image || simposio?.data.image || '/images/hero-bg.jpg';
---

<Layout
  title={pageTitle}
  description={data.description}
  image={heroImage}
  canonical={`/${data.slug || data.template}/`}
>
  <PageTemplate data={data} simposio={simposio} simposioTitle={simposioTitle} entries={entries}>
    <Content />
  </PageTemplate>
</Layout>
