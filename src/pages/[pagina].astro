---
import Layout from '../layouts/Layout.astro';
import PageTemplate from '../components/PageTemplate.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { getSimposioDefault, resolveSimposioSlug } from '../lib/simposios';

interface Props {
  entry: CollectionEntry<'paginas'>;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const defaultSlug = await resolveSimposioSlug();
  const paginas = await getCollection('paginas', ({ data }) => !data.draft && data.simposio === defaultSlug);
  return paginas.map((entry) => ({
    params: { pagina: entry.data.slug || entry.data.template },
    props: { entry },
  }));
};

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const simposio = await getSimposioDefault();
const simposioTitle = simposio?.data.title || 'I Simposio sobre Memorias Participativas';

const pageTitle = `${data.title} - ${simposioTitle}`;
const heroImage = data.image || simposio?.data.image || '/images/hero-bg.jpg';
---

<Layout title={pageTitle} description={data.description} image={heroImage}>
  <PageTemplate data={data} simposio={simposio} simposioTitle={simposioTitle}>
    <Content />
  </PageTemplate>
</Layout>
