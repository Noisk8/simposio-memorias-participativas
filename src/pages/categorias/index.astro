---
/**
 * /categorias/ — Índice de todas las categorías (estilo WordPress).
 */
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getCategorias } from '../../lib/taxonomies';

const categorias = await getCategorias();

const entradas = await getCollection('entradas', ({ data }) => !data.draft);
const proyectos = await getCollection('proyectos', ({ data }) => !data.draft);

function countFor(title: string) {
  return (
    entradas.filter((e) => e.data.categories?.includes(title)).length +
    proyectos.filter((p) => p.data.categories?.includes(title)).length
  );
}

const raices = categorias.filter((c) => !c.parent);
const hijasDe = (title: string) => categorias.filter((c) => c.parent === title);
---

<Layout title="Categorías - I Simposio sobre Memorias Participativas">
  <section class="bg-ugr-green py-14 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <nav class="text-white/70 text-sm mb-4">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <span class="mx-2">/</span>
        <span class="text-white">Categorías</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-bold text-white font-[family-name:var(--font-heading)] drop-shadow-lg">
        Categorías
      </h1>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4">
      {categorias.length === 0 && (
        <p class="text-center text-ugr-text-light py-16">No hay categorías creadas todavía.</p>
      )}
      <div class="grid gap-4 md:grid-cols-2">
        {raices.map((cat) => (
          <div class="border border-gray-100 rounded-xl p-5 shadow-sm">
            <a
              href={`/categorias/${cat.slug}/`}
              class="text-lg font-bold text-ugr-green-dark hover:text-ugr-green transition-colors font-[family-name:var(--font-heading)]"
            >
              {cat.title}
              <span class="ml-2 text-xs font-semibold text-ugr-text-light">({countFor(cat.title)})</span>
            </a>
            {cat.description && (
              <p class="text-sm text-ugr-text-light mt-1">{cat.description}</p>
            )}
            {hijasDe(cat.title).length > 0 && (
              <ul class="mt-3 pl-4 border-l-2 border-ugr-green/20 space-y-1">
                {hijasDe(cat.title).map((hija) => (
                  <li>
                    <a
                      href={`/categorias/${hija.slug}/`}
                      class="text-sm font-semibold text-ugr-green hover:underline"
                    >
                      {hija.title}
                      <span class="ml-1 text-xs text-ugr-text-light">({countFor(hija.title)})</span>
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
