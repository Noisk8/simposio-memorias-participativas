---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada - Red Internacional de Memorias Participativas">
  <section class="min-h-[60vh] flex items-center justify-center px-4 py-16">
    <div class="text-center max-w-lg">
      <div class="mb-8">
        <span class="text-8xl font-bold text-ugr-green/20 font-[family-name:var(--font-heading)]"
          >404</span
        >
      </div>
      <h1
        class="text-2xl md:text-3xl font-bold text-ugr-green-dark mb-4 font-[family-name:var(--font-heading)]"
      >
        Página no encontrada
      </h1>
      <p class="text-lg text-[var(--ugr-text-light)] mb-8 leading-relaxed">
        Lo sentimos, la página que buscas no existe o ha sido movida a otra ubicación.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/" class="btn-green text-center"> Volver al inicio </a>
        <a
          href="/entradas"
          class="inline-block text-center px-6 py-3 rounded-lg font-semibold border-2 border-ugr-green text-ugr-green hover:bg-ugr-green hover:text-white transition-all duration-300"
        >
          Ver entradas
        </a>
      </div>
    </div>
  </section>
</Layout>
