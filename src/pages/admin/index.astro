---
import AdminLayout from '../../layouts/AdminLayout.astro';
import SupabaseAuth from '../../components/SupabaseAuth.astro';
---

<AdminLayout title="Panel de administración">
  <section class="cms-welcome-page">
    <div class="cms-welcome-wrap">
      <header class="cms-welcome-hero">
        <p>Panel de administración</p><h1>Hola, <span id="welcome-name">bienvenido/a</span></h1>
        <div>Elige una tarea para empezar a trabajar con las memorias y contenidos de la Red.</div>
        <button id="open-tour" type="button">Ver guía paso a paso</button>
      </header>

      <SupabaseAuth redirectUnauthenticated />
      <p id="admin-loading" class="text-ugr-text-light">Verificando sesión de Supabase...</p>

      <div id="admin-dashboard" class="hidden cms-welcome-dashboard">
        <h2>Acciones frecuentes</h2><div class="cms-welcome-grid">
          <a href="/admin/contenidos?collection=entradas&new=1"
            ><h3>＋ Crear entrada</h3><p>Publicar una noticia, artículo o novedad.</p></a
          >
          <a href="/admin/contenidos?collection=memorias&new=1"
            ><h3>＋ Añadir memoria</h3><p>Incorporar una pieza al Museo de Memorias Vivas.</p></a
          >
          <a href="/admin/contenidos?collection=entradas&drafts=1"
            ><h3>Ver borradores</h3><p>Revisar contenidos antes de publicar.</p></a
          >
        </div>
        <h2>Contenido del sitio</h2><div class="cms-welcome-grid">
          <a href="/admin/contenidos" class="cms-wide">
            <h2 class="text-xl font-semibold text-ugr-green-dark mb-2">Gestionar contenidos</h2>
            <p class="text-sm text-ugr-text-light">
              Crear y editar entradas, memorias, páginas, simposios, categorías y etiquetas.
            </p>
          </a>
        </div><h2>Administración</h2><div class="cms-welcome-grid">
          <a
            href="/admin/crear-memoria"
            class="block border border-gray-200 rounded-xl p-6 hover:border-ugr-green hover:shadow-md transition-all"
          >
            <h2 class="text-xl font-semibold text-ugr-green-dark mb-2">Crear memoria</h2>
            <p class="text-sm text-ugr-text-light">
              Crear una memoria mediante la API administrativa protegida.
            </p>
          </a>
          <a
            href="/admin/gestion-usuarios"
            class="block border border-gray-200 rounded-xl p-6 hover:border-ugr-green hover:shadow-md transition-all"
          >
            <h2 class="text-xl font-semibold text-ugr-green-dark mb-2">Usuarios y roles</h2>
            <p class="text-sm text-ugr-text-light">
              Gestionar cuentas y permisos RBAC de Supabase.
            </p>
          </a>
          <a
            href="/admin/medios"
            class="block border border-gray-200 rounded-xl p-6 hover:border-ugr-green hover:shadow-md transition-all"
          >
            <h2 class="text-xl font-semibold text-ugr-green-dark mb-2">Biblioteca de imágenes</h2>
            <p class="text-sm text-ugr-text-light">
              Subir, consultar y eliminar imágenes del sitio.
            </p>
          </a>
        </div>
      </div>
      <div
        id="cms-tour"
        class="cms-tour hidden"
        role="dialog"
        aria-modal="true"
        aria-labelledby="tour-title"
      >
        <div class="cms-tour-card">
          <div class="cms-tour-progress"><span id="tour-progress"></span></div><div
            class="cms-tour-content"
          >
            <small id="tour-step"></small><h2 id="tour-title"></h2><p id="tour-text"></p>
          </div><footer>
            <label
              ><input id="tour-suppress" type="checkbox" /> No mostrar automáticamente otra vez</label
            ><div>
              <button id="tour-skip" type="button">Saltar guía</button><button
                id="tour-back"
                type="button">Atrás</button
              ><button id="tour-next" type="button">Siguiente</button>
            </div>
          </footer>
        </div>
      </div>
    </div>
  </section>
</AdminLayout>

<script src="../../scripts/admin/dashboard.ts"></script>

<style is:global>
  .cms-welcome-page {
    min-height: calc(100vh - 54px);
    padding: 30px;
    background: var(--cms-bg);
  }
  .cms-welcome-wrap {
    max-width: 1080px;
    margin: auto;
  }
  .cms-welcome-hero {
    padding: 34px;
    border-radius: 18px;
    background: linear-gradient(135deg, #287bb8, #1d5d91);
    color: #fff;
    box-shadow: 0 18px 45px #10182820;
  }
  .cms-welcome-hero > p {
    margin: 0 0 8px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 13px;
    font-weight: 700;
  }
  .cms-welcome-hero h1 {
    font-family: var(--font-montserrat), sans-serif;
    font-size: 40px;
    margin: 0 0 8px;
  }
  .cms-welcome-hero button {
    margin-top: 20px;
    border: 1px solid #ffffff80;
    border-radius: 8px;
    padding: 10px 14px;
    background: #fff;
    color: #175486;
    font-weight: 700;
  }
  .cms-welcome-dashboard h2 {
    margin: 28px 0 12px;
    color: var(--cms-text);
  }
  .cms-welcome-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 14px;
  }
  .cms-welcome-grid a {
    display: block;
    padding: 20px;
    border: 1px solid var(--cms-border);
    border-radius: 14px;
    background: var(--cms-panel);
    color: var(--cms-text) !important;
    box-shadow: 0 8px 20px #1018280a;
  }
  .cms-welcome-grid a:hover {
    transform: translateY(-2px);
    border-color: var(--cms-blue);
  }
  .cms-welcome-grid h2,
  .cms-welcome-grid h3 {
    font-family: var(--font-montserrat), sans-serif;
    margin: 0 0 6px;
    color: var(--cms-text);
  }
  .cms-welcome-grid p {
    margin: 0;
    color: var(--cms-muted);
  }
  .cms-tour {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: #101828a8;
    display: grid;
    place-items: center;
    padding: 18px;
  }
  .cms-tour.hidden {
    display: none;
  }
  .cms-tour-card {
    width: min(620px, 100%);
    max-height: calc(100vh - 36px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 18px;
    background: var(--cms-panel);
    color: var(--cms-text);
    box-shadow: 0 30px 80px #0006;
  }
  .cms-tour-progress {
    height: 6px;
    background: var(--cms-border);
  }
  .cms-tour-progress span {
    display: block;
    height: 100%;
    background: var(--cms-blue);
    transition: width 0.25s;
  }
  .cms-tour-content {
    min-height: 190px;
    padding: 34px;
    overflow-y: auto;
  }
  .cms-tour-content small {
    color: var(--cms-blue);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }
  .cms-tour-content h2 {
    font-family: var(--font-montserrat), sans-serif;
    font-size: 28px;
    margin: 14px 0;
  }
  .cms-tour-content p {
    font-size: 18px;
    line-height: 1.6;
    color: var(--cms-muted);
    white-space: pre-line;
  }
  .cms-tour-card footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    padding: 18px 25px;
    border-top: 1px solid var(--cms-border);
  }
  .cms-tour-card footer button {
    border: 1px solid var(--cms-border);
    border-radius: 7px;
    padding: 9px 13px;
    background: var(--cms-panel);
    color: var(--cms-text);
  }
  .cms-tour-card footer > div {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  #tour-next {
    background: var(--cms-blue);
    color: #fff;
  }
  .cms-tour-card footer label {
    font-size: 13px;
    color: var(--cms-muted);
  }
  @media (max-width: 650px) {
    .cms-welcome-page {
      padding: 14px;
    }
    .cms-tour-card footer {
      align-items: flex-start;
      flex-direction: column;
    }
    .cms-welcome-hero h1 {
      font-size: 32px;
    }
  }
</style>
