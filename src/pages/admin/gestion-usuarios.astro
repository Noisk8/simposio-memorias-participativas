---
import AdminLayout from '../../layouts/AdminLayout.astro';
import SupabaseAuth from '../../components/SupabaseAuth.astro';

const roles = ['superadmin', 'admin', 'editor', 'reviewer', 'author', 'read_only'];
const roleLabels: Record<string, string> = {
  superadmin: 'Superadministración',
  admin: 'Administración',
  editor: 'Edición',
  reviewer: 'Revisión',
  author: 'Autoría',
  read_only: 'Solo lectura',
};
---

<AdminLayout title="Usuarios y roles - Admin">
  <section class="cms-users-page">
    <div class="cms-users-wrap">
      <header class="cms-users-hero">
        <div>
          <p>Administración</p>
          <h1>Usuarios y roles</h1>
          <div>
            Gestiona el acceso al CMS y asigna un rol efectivo a cada integrante del equipo.
          </div>
        </div>
        <a href="/admin/">← Volver al panel</a>
      </header>

      <SupabaseAuth redirectUnauthenticated />

      <div id="not-allowed" class="cms-users-alert hidden" role="alert"></div>
      <div id="loading" class="cms-users-loading">
        <span class="cms-users-spinner" aria-hidden="true"></span>
        Verificando sesión…
      </div>

      <div id="admin-panel" class="hidden">
        <section class="cms-users-card cms-users-create">
          <header class="cms-users-card-header">
            <div>
              <p>Alta de usuarios</p>
              <h2>Crear y notificar acceso</h2>
              <span
                >Si dejas la contraseña vacía, el sistema generará una temporal segura y la enviará
                por correo.</span
              >
            </div>
          </header>

          <form id="create-user-form" class="cms-create-form">
            <div class="cms-create-grid">
              <label>
                <span>Nombre completo</span>
                <input
                  id="create-user-name"
                  type="text"
                  maxlength="100"
                  autocomplete="name"
                  required
                />
              </label>
              <label>
                <span>Email</span>
                <input id="create-user-email" type="email" autocomplete="email" required />
              </label>
              <label>
                <span>Rol inicial</span>
                <select id="create-user-role">
                  {
                    roles.map((role) => (
                      <option value={role} selected={role === 'author'}>
                        {roleLabels[role]}
                      </option>
                    ))
                  }
                </select>
              </label>
              <label>
                <span>Contraseña temporal</span>
                <input
                  id="create-user-password"
                  type="password"
                  autocomplete="new-password"
                  minlength="8"
                  maxlength="72"
                  placeholder="Opcional: se autogenera si lo dejas vacío"
                />
              </label>
            </div>

            <div class="cms-create-actions">
              <button id="create-user-btn" type="submit">Crear usuario y enviar acceso</button>
              <p>
                El correo de acceso incluye el email, la contraseña temporal y el enlace al panel.
              </p>
            </div>
          </form>

          <div id="create-user-error" class="cms-users-alert hidden" role="alert"></div>
          <div id="invite-credentials" class="cms-invite-credentials hidden" aria-live="polite">
          </div>
        </section>

        <section class="cms-users-stats" aria-label="Resumen de usuarios">
          <article>
            <span class="cms-stat-icon cms-stat-blue">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
              </svg>
            </span>
            <div><strong id="stat-total">0</strong><span>Usuarios cargados</span></div>
          </article>
          <article>
            <span class="cms-stat-icon cms-stat-purple">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </span>
            <div><strong id="stat-managers">0</strong><span>Administración</span></div>
          </article>
          <article>
            <span class="cms-stat-icon cms-stat-green">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M17 3a2.828 2.828 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5L17 3z"></path>
              </svg>
            </span>
            <div><strong id="stat-editorial">0</strong><span>Equipo editorial</span></div>
          </article>
          <article>
            <span class="cms-stat-icon cms-stat-amber">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                <circle cx="8.5" cy="7" r="4"></circle>
                <line x1="18" y1="8" x2="23" y2="13"></line>
                <line x1="23" y1="8" x2="18" y2="13"></line>
              </svg>
            </span>
            <div><strong id="stat-inactive">0</strong><span>Sin acceso activo</span></div>
          </article>
        </section>

        <section class="cms-users-card">
          <header class="cms-users-card-header">
            <div>
              <p>Directorio del CMS</p>
              <h2>Usuarios registrados</h2>
              <span id="users-summary">Consulta y modifica los permisos del equipo.</span>
            </div>
            <div class="cms-users-tools">
              <label>
                <span class="sr-only">Buscar usuarios</span>
                <input id="user-search" type="search" placeholder="Buscar por nombre o correo…" />
              </label>
              <button id="refresh-btn" type="button">↻ Actualizar</button>
            </div>
          </header>

          <div id="users-loading" class="cms-users-table-loading">Cargando usuarios…</div>
          <div id="users-error" class="cms-users-alert hidden" role="alert"></div>

          <div class="cms-users-table-wrap">
            <table id="users-table" class="hidden">
              <thead>
                <tr>
                  <th>Usuario</th>
                  <th>Estado</th>
                  <th>Rol actual</th>
                  <th>Asignar rol</th>
                </tr>
              </thead>
              <tbody id="users-body"></tbody>
            </table>
          </div>

          <div id="users-empty" class="cms-users-empty hidden">
            <span>⌕</span>
            <strong>No encontramos usuarios</strong>
            <p>Prueba con otro nombre o correo electrónico.</p>
          </div>

          <p id="action-status" class="cms-users-action-status" aria-live="polite"></p>
        </section>
      </div>
    </div>
  </section>
</AdminLayout>

<script src="../../scripts/admin/users.ts"></script>

<style is:global>
  .cms-users-page {
    min-height: calc(100vh - 54px);
    padding: 30px;
    background: var(--cms-bg);
    color: var(--cms-text);
  }
  .cms-users-wrap {
    max-width: 1180px;
    margin: 0 auto;
  }
  .cms-users-hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 30px 34px;
    border-radius: 18px;
    background: linear-gradient(135deg, #287bb8, #1d5d91);
    color: #fff;
    box-shadow: 0 18px 45px #10182820;
  }
  .cms-users-hero p,
  .cms-users-card-header p {
    margin: 0 0 7px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 12px;
    font-weight: 800;
  }
  .cms-users-hero h1 {
    margin: 0 0 8px;
    color: #fff;
    font-size: clamp(30px, 4vw, 40px);
    line-height: 1.15;
  }
  .cms-users-hero > div > div {
    max-width: 690px;
    color: #e9f4ff;
  }
  .cms-users-hero a {
    flex: 0 0 auto;
    border: 1px solid #ffffff70;
    border-radius: 8px;
    padding: 9px 13px;
    background: #ffffff12;
    color: #fff !important;
    font-size: 14px;
    font-weight: 700;
  }
  .cms-users-hero a:hover {
    background: #fff;
    color: #175486 !important;
  }
  .cms-users-page #supabase-user-info,
  .cms-users-page #supabase-signout {
    display: none !important;
  }
  .cms-users-loading,
  .cms-users-table-loading {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
    padding: 17px 20px;
    border: 1px solid var(--cms-border);
    border-radius: 12px;
    background: var(--cms-panel);
    color: var(--cms-muted);
  }
  .cms-users-spinner {
    width: 17px;
    height: 17px;
    border: 2px solid var(--cms-border);
    border-top-color: var(--cms-blue);
    border-radius: 50%;
    animation: cms-users-spin 0.8s linear infinite;
  }
  @keyframes cms-users-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .cms-users-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin: 22px 0;
  }
  .cms-users-stats article {
    display: flex;
    align-items: center;
    gap: 13px;
    min-width: 0;
    padding: 18px;
    border: 1px solid var(--cms-border);
    border-radius: 14px;
    background: var(--cms-panel);
    box-shadow: 0 8px 20px #1018280a;
  }
  .cms-stat-icon {
    display: grid;
    flex: 0 0 42px;
    height: 42px;
    place-items: center;
    border-radius: 11px;
    box-sizing: border-box;
    padding: 6px;
  }
  .cms-stat-icon svg {
    display: block;
    flex: 0 0 auto;
    width: 100%;
    height: 100%;
  }
  .cms-stat-blue {
    background: #e8f2fb;
    color: #287bb8;
  }
  .cms-stat-purple {
    background: #f0eafe;
    color: #6941c6;
  }
  .cms-stat-green {
    background: #e8f7ef;
    color: #18794e;
  }
  .cms-stat-amber {
    background: #fff4df;
    color: #b54708;
  }
  .cms-users-stats strong,
  .cms-users-stats span {
    display: block;
  }
  .cms-users-stats strong {
    font-size: 24px;
    line-height: 1;
  }
  .cms-users-stats article div span {
    margin-top: 5px;
    overflow: hidden;
    color: var(--cms-muted);
    font-size: 12px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cms-users-card {
    overflow: hidden;
    border: 1px solid var(--cms-border);
    border-radius: 18px;
    background: var(--cms-panel);
    box-shadow: 0 14px 35px #10182810;
  }
  .cms-users-card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    padding: 22px 24px;
    border-bottom: 1px solid var(--cms-border);
  }
  .cms-users-card-header p {
    color: var(--cms-blue);
  }
  .cms-users-card-header h2 {
    margin: 0 0 3px;
    color: var(--cms-text);
    font-size: 23px;
  }
  .cms-users-card-header span {
    color: var(--cms-muted);
    font-size: 13px;
  }
  .cms-users-create {
    margin-top: 22px;
  }
  .cms-create-form {
    padding: 22px 24px 24px;
  }
  .cms-create-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }
  .cms-create-grid label {
    display: grid;
    gap: 7px;
    color: var(--cms-text);
    font-size: 13px;
    font-weight: 700;
  }
  .cms-create-grid label span {
    color: var(--cms-text);
  }
  .cms-create-grid input,
  .cms-create-grid select {
    width: 100%;
    height: 42px;
    box-sizing: border-box;
    border: 1px solid var(--cms-border);
    border-radius: 10px;
    background: var(--cms-panel);
    color: var(--cms-text);
    font: inherit;
    padding: 0 12px;
  }
  .cms-create-grid select {
    padding-right: 32px;
  }
  .cms-create-grid input::placeholder {
    color: color-mix(in srgb, var(--cms-muted) 80%, transparent);
  }
  .cms-create-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    margin-top: 18px;
  }
  .cms-create-actions button {
    height: 42px;
    border: 0;
    border-radius: 10px;
    padding: 0 16px;
    background: linear-gradient(135deg, #287bb8, #1d5d91);
    color: #fff;
    font: inherit;
    font-size: 14px;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 10px 20px #1d5d9122;
  }
  .cms-create-actions button:disabled {
    cursor: not-allowed;
    opacity: 0.55;
  }
  .cms-create-actions p {
    margin: 0;
    color: var(--cms-muted);
    font-size: 13px;
  }
  .cms-invite-credentials {
    display: grid;
    gap: 8px;
    margin: 0 24px 24px;
    border: 1px solid #d0e7f7;
    border-radius: 14px;
    padding: 16px 18px;
    background: linear-gradient(180deg, #f8fcff, #eef7fd);
    color: var(--cms-text);
  }
  .cms-invite-credentials strong {
    color: #175486;
    font-size: 15px;
  }
  .cms-invite-credentials p,
  .cms-invite-credentials small {
    margin: 0;
    color: var(--cms-muted);
  }
  .cms-invite-credentials code {
    width: fit-content;
    border: 1px solid #d0e7f7;
    border-radius: 8px;
    padding: 8px 10px;
    background: #fff;
    color: #175486;
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.03em;
    word-break: break-word;
  }
  .cms-users-create .cms-users-alert {
    margin: 0 24px 16px;
  }
  .cms-users-tools,
  .cms-role-control {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .cms-users-tools input,
  .cms-role-control select {
    height: 40px;
    box-sizing: border-box;
    border: 1px solid var(--cms-border);
    border-radius: 9px;
    background: var(--cms-panel);
    color: var(--cms-text);
    font: inherit;
  }
  .cms-users-tools input {
    width: 250px;
    padding: 0 12px;
  }
  .cms-users-tools button,
  .cms-role-control button {
    height: 40px;
    border: 0;
    border-radius: 8px;
    padding: 0 14px;
    background: var(--cms-blue);
    color: #fff;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }
  .cms-users-tools button:disabled,
  .cms-role-control button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }
  .cms-users-table-wrap {
    overflow-x: auto;
  }
  .cms-users-card table {
    width: 100%;
    min-width: 820px;
    border-collapse: collapse;
    text-align: left;
  }
  .cms-users-card th {
    padding: 12px 20px;
    background: color-mix(in srgb, var(--cms-bg) 70%, var(--cms-panel));
    color: var(--cms-muted);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .cms-users-card td {
    padding: 16px 20px;
    border-top: 1px solid var(--cms-border);
    color: var(--cms-text);
    vertical-align: middle;
  }
  .cms-users-card tbody tr:hover {
    background: color-mix(in srgb, var(--cms-blue) 5%, var(--cms-panel));
  }
  .cms-user-identity {
    display: flex;
    align-items: center;
    gap: 11px;
  }
  .cms-user-avatar {
    display: grid;
    flex: 0 0 38px;
    height: 38px;
    place-items: center;
    border-radius: 50%;
    background: linear-gradient(135deg, #287bb8, #1d5d91);
    color: #fff;
    font-size: 17px;
    font-weight: 800;
    line-height: 1;
    user-select: none;
  }
  .cms-user-identity strong,
  .cms-user-identity span {
    display: block;
  }
  .cms-user-identity .cms-user-avatar {
    display: grid;
    place-items: center;
  }
  .cms-user-avatar img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }
  .cms-user-identity div span {
    margin-top: 2px;
    color: var(--cms-muted);
    font-size: 12px;
  }
  .cms-user-status,
  .cms-role-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 5px 9px;
    font-size: 11px;
    font-weight: 800;
  }
  .cms-user-status {
    background: #e8f7ef;
    color: #18794e;
  }
  .cms-user-status::before {
    width: 6px;
    height: 6px;
    margin-right: 6px;
    border-radius: 50%;
    background: currentColor;
    content: '';
  }
  .cms-user-status[data-disabled='true'] {
    background: #fef0ec;
    color: #b42318;
  }
  .cms-role-badge {
    background: #e8f2fb;
    color: #175486;
  }
  .cms-role-badge[data-role='superadmin'],
  .cms-role-badge[data-role='admin'] {
    background: #f0eafe;
    color: #6941c6;
  }
  .cms-role-badge[data-role='author'],
  .cms-role-badge[data-role='reviewer'] {
    background: #fff4df;
    color: #b54708;
  }
  .cms-role-badge[data-role='read_only'],
  .cms-role-badge[data-role='none'] {
    background: #f2f4f7;
    color: #475467;
  }
  .cms-role-control select {
    min-width: 170px;
    padding: 0 34px 0 10px;
    font-size: 13px;
  }
  .cms-users-alert {
    margin: 18px 0;
    border: 1px solid #fecdca;
    border-radius: 11px;
    padding: 14px 17px;
    background: #fef3f2;
    color: #b42318;
  }
  .cms-users-table-loading {
    margin: 18px;
    box-shadow: none;
  }
  .cms-users-empty {
    padding: 55px 20px;
    color: var(--cms-muted);
    text-align: center;
  }
  .cms-users-empty > span,
  .cms-users-empty strong {
    display: block;
  }
  .cms-users-empty > span {
    margin-bottom: 8px;
    font-size: 36px;
  }
  .cms-users-empty strong {
    color: var(--cms-text);
  }
  .cms-users-empty p {
    margin: 5px 0 0;
  }
  .cms-users-action-status {
    min-height: 20px;
    margin: 0;
    padding: 12px 20px;
    border-top: 1px solid var(--cms-border);
    color: var(--cms-muted);
    font-size: 13px;
  }
  .cms-users-action-status:empty {
    display: none;
  }
  .cms-users-action-status[data-kind='success'] {
    background: #ecfdf3;
    color: #18794e;
  }
  .cms-users-action-status[data-kind='warning'] {
    background: #fffaeb;
    color: #b54708;
  }
  .cms-users-action-status[data-kind='error'] {
    background: #fef3f2;
    color: #b42318;
  }
  .cms-users-page .hidden {
    display: none !important;
  }
  @media (max-width: 900px) {
    .cms-create-grid {
      grid-template-columns: 1fr;
    }
    .cms-users-stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .cms-users-card-header {
      align-items: stretch;
      flex-direction: column;
    }
    .cms-create-actions {
      align-items: flex-start;
    }
    .cms-users-tools input {
      width: min(100%, 360px);
    }
  }
  @media (max-width: 600px) {
    .cms-users-page {
      padding: 14px;
    }
    .cms-users-hero {
      padding: 24px;
      flex-direction: column;
    }
    .cms-create-form {
      padding: 18px 18px 20px;
    }
    .cms-invite-credentials {
      margin: 0 18px 18px;
    }
    .cms-users-create .cms-users-alert {
      margin: 0 18px 14px;
    }
    .cms-users-stats {
      grid-template-columns: 1fr;
    }
    .cms-users-tools {
      align-items: stretch;
      flex-direction: column;
    }
    .cms-users-tools input,
    .cms-users-tools button {
      width: 100%;
    }
  }
</style>
