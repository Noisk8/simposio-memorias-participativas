---
import AdminLayout from '../../layouts/AdminLayout.astro';
import SupabaseAuth from '../../components/SupabaseAuth.astro';
---

<AdminLayout title="Biblioteca de imágenes - Admin">
  <section class="min-h-[70vh] bg-gray-50 py-10">
    <div class="mx-auto max-w-6xl px-4">
      <a href="/admin/" class="text-sm text-ugr-green hover:underline">← Panel</a>
      <h1 class="mt-2 text-3xl font-bold text-ugr-green-dark">Biblioteca de imágenes</h1>
      <p class="mb-7 mt-2 text-ugr-text-light">
        Sube imágenes y copia su ruta para utilizarla en los contenidos.
      </p>
      <SupabaseAuth redirectUnauthenticated />
      <div id="status" class="mb-5 rounded-lg bg-white p-4 text-sm shadow-sm">
        Verificando sesión…
      </div>
      <div id="media-panel" class="hidden">
        <form
          id="upload"
          class="mb-7 flex flex-wrap items-end gap-3 rounded-xl border border-gray-200 bg-white p-5 shadow-sm"
        >
          <div>
            <label for="file" class="mb-1 block text-sm font-semibold"
              >Nueva imagen (máximo 6 MB)</label
            ><input
              id="file"
              type="file"
              accept="image/jpeg,image/png,image/webp,image/gif,image/avif"
              required
              class="block text-sm"
            />
          </div>
          <button class="rounded-lg bg-ugr-green px-5 py-2.5 font-semibold text-white"
            >Subir imagen</button
          >
        </form>
        <div id="images" class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5"></div>
      </div>
    </div>
  </section>
</AdminLayout>
<script is:inline>
  // @ts-nocheck
  const panel = document.getElementById('media-panel'),
    statusNode = document.getElementById('status'),
    imagesNode = document.getElementById('images');
  async function api(url, options = {}) {
    const token = await window.supabaseAuth.getToken();
    const response = await fetch(url, {
      ...options,
      headers: { Authorization: 'Bearer ' + token, 'Content-Type': 'application/json' },
    });
    const type = response.headers.get('content-type') || '';
    if (!type.includes('application/json'))
      throw new Error(
        'Las funciones administrativas no están disponibles. Usa netlify dev o producción.'
      );
    const data = await response.json();
    if (!response.ok) throw new Error(data.error?.message || 'Error inesperado.');
    return data;
  }
  function status(message, error = false) {
    statusNode.textContent = message;
    statusNode.className =
      'mb-5 rounded-lg p-4 text-sm shadow-sm ' + (error ? 'bg-red-50 text-red-700' : 'bg-white');
  }
  function escapeHtml(value) {
    const span = document.createElement('span');
    span.textContent = String(value || '');
    return span.innerHTML;
  }
  async function load() {
    try {
      const data = await api('/.netlify/functions/manage-media');
      imagesNode.innerHTML = '';
      data.images.forEach((image) => {
        const card = document.createElement('article');
        card.className = 'overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm';
        card.innerHTML =
          '<img src="' +
          escapeHtml(image.path) +
          '" alt="" loading="lazy" class="h-32 w-full bg-gray-100 object-cover"><div class="p-3"><p class="truncate text-xs font-medium">' +
          escapeHtml(image.name) +
          '</p><div class="mt-2 flex gap-2"><button class="copy text-xs text-ugr-green">Copiar ruta</button><button class="delete text-xs text-red-700">Eliminar</button></div></div>';
        card.querySelector('.copy').onclick = async () => {
          await navigator.clipboard.writeText(image.path);
          status('Ruta copiada: ' + image.path);
        };
        card.querySelector('.delete').onclick = async () => {
          if (!confirm('¿Eliminar ' + image.name + '?')) return;
          try {
            await api(
              '/.netlify/functions/manage-media?name=' +
                encodeURIComponent(image.name) +
                '&sha=' +
                image.sha,
              { method: 'DELETE' }
            );
            await load();
          } catch (error) {
            status(error.message, true);
          }
        };
        imagesNode.appendChild(card);
      });
      status(data.images.length + ' imágenes cargadas.');
    } catch (error) {
      status(error.message, true);
    }
  }
  document.getElementById('upload').onsubmit = async (event) => {
    event.preventDefault();
    const file = document.getElementById('file').files[0];
    if (!file) return;
    status('Subiendo imagen…');
    const reader = new FileReader();
    reader.onload = async () => {
      try {
        const content = String(reader.result).split(',')[1];
        await api('/.netlify/functions/manage-media', {
          method: 'POST',
          body: JSON.stringify({ name: file.name, content }),
        });
        event.target.reset();
        await load();
      } catch (error) {
        status(error.message, true);
      }
    };
    reader.readAsDataURL(file);
  };
  function start() {
    window.supabaseAuth.ready.then(async () => {
      if (await window.supabaseAuth.getUser()) {
        panel.classList.remove('hidden');
        load();
      }
    });
  }
  (function wait() {
    if (window.supabaseAuth) return start();
    setTimeout(wait, 100);
  })();
</script>
