---
import AdminLayout from '../../layouts/AdminLayout.astro';
import SupabaseAuth from '../../components/SupabaseAuth.astro';
---

<AdminLayout title="Biblioteca de medios - Admin">
  <section class="cms-media-page">
    <div class="cms-media-wrap">
      <header class="cms-media-hero">
        <div>
          <p>Administración</p>
          <h1>Biblioteca de medios</h1>
          <div>
            Administra imágenes JPEG, PNG y WebP o documentos PDF en Supabase Storage y copia sus
            URLs estables para usarlas en el contenido.
          </div>
        </div>
        <a href="/admin/">← Volver al panel</a>
      </header>

      <SupabaseAuth redirectUnauthenticated />

      <div id="status" class="cms-media-status" aria-live="polite">
        <span class="cms-media-spinner" aria-hidden="true"></span>
        Verificando sesión…
      </div>

      <div id="media-panel" class="hidden">
        <section class="cms-media-stats" aria-label="Resumen de la biblioteca">
          <article>
            <span class="cms-media-stat-icon cms-media-stat-blue">
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
              </svg>
            </span>
            <div><strong id="media-count">0</strong><span>Archivos cargados</span></div>
          </article>
          <article>
            <span class="cms-media-stat-icon cms-media-stat-green">
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <line x1="22" y1="12" x2="2" y2="12"></line>
                <path
                  d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"
                ></path>
                <line x1="6" y1="16" x2="6.01" y2="16"></line>
                <line x1="10" y1="16" x2="10.01" y2="16"></line>
              </svg>
            </span>
            <div><strong id="media-size">0 KB</strong><span>Peso total visible</span></div>
          </article>
          <article>
            <span class="cms-media-stat-icon cms-media-stat-purple">
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polygon points="12 2 2 7 12 12 22 7 12 2"></polygon>
                <polyline points="2 17 12 22 22 17"></polyline>
                <polyline points="2 12 12 17 22 12"></polyline>
              </svg>
            </span>
            <div><strong id="media-formats">0</strong><span>Formatos usados</span></div>
          </article>
          <article>
            <span class="cms-media-stat-icon cms-media-stat-amber">
              <svg
                viewBox="0 0 24 24"
                width="20"
                height="20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </span>
            <div><strong id="media-max-size">2 MiB</strong><span>Máximo por archivo</span></div>
          </article>
        </section>

        <form id="upload" class="cms-media-upload">
          <div class="cms-media-upload-copy">
            <span aria-hidden="true">↑</span>
            <div>
              <h2>Subir nuevo medio</h2>
              <p>Únicamente imágenes JPEG, PNG o WebP y documentos PDF. Máximo: 2 MiB.</p>
            </div>
          </div>

          <div class="cms-media-upload-controls">
            <label class="cms-media-file-picker" for="file">
              <input
                id="file"
                type="file"
                accept="image/jpeg,image/png,image/webp,application/pdf"
                required
              />
              <span id="file-name">Seleccionar archivo</span>
            </label>
            <button id="upload-button" type="submit">Subir medio</button>
          </div>

          <fieldset id="image-metadata" class="cms-media-metadata hidden">
            <legend>Metadata editorial obligatoria de la imagen</legend>
            <label class="cms-media-decorative">
              <input id="decorative" type="checkbox" />
              <span>La imagen es decorativa</span>
            </label>
            <label>
              <span>Texto alternativo</span>
              <textarea id="alt-text" maxlength="500" rows="2"></textarea>
              <small>Describe el contenido o marca explícitamente la imagen como decorativa.</small>
            </label>
            <label>
              <span>Crédito</span>
              <input id="credit" type="text" maxlength="500" />
            </label>
            <label>
              <span>Licencia</span>
              <input id="license" type="text" maxlength="255" placeholder="Ej. CC BY-SA 4.0" />
            </label>
          </fieldset>
        </form>

        <section class="cms-media-library">
          <header class="cms-media-library-header">
            <div>
              <p>Recursos disponibles</p>
              <h2>Biblioteca del sitio</h2>
              <span id="media-summary">Carga la biblioteca para ver los medios.</span>
            </div>
            <div class="cms-media-tools">
              <label>
                <span class="sr-only">Buscar medios</span>
                <input id="media-search" type="search" placeholder="Buscar por nombre o formato…" />
              </label>
              <button id="refresh-media" type="button">↻ Actualizar</button>
            </div>
          </header>

          <div id="images" class="cms-media-grid"></div>

          <div id="media-empty" class="cms-media-empty hidden">
            <span>⌕</span>
            <strong>No encontramos medios</strong>
            <p>Prueba con otro nombre, extensión o limpia la búsqueda.</p>
          </div>
        </section>
      </div>
    </div>
  </section>
</AdminLayout>

<script src="../../scripts/admin/media-library.ts"></script>

<style is:global>
  .cms-media-page {
    min-height: calc(100vh - 54px);
    padding: 30px;
    background: var(--cms-bg);
    color: var(--cms-text);
  }
  .cms-media-wrap {
    max-width: 1180px;
    margin: 0 auto;
  }
  .cms-media-hero {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    padding: 30px 34px;
    border-radius: 18px;
    background: linear-gradient(135deg, #287bb8, #1d5d91);
    color: #fff;
    box-shadow: 0 18px 45px #10182820;
  }
  .cms-media-hero p,
  .cms-media-library-header p {
    margin: 0 0 7px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 12px;
    font-weight: 800;
  }
  .cms-media-hero h1 {
    margin: 0 0 8px;
    color: #fff;
    font-size: clamp(30px, 4vw, 40px);
    line-height: 1.15;
  }
  .cms-media-hero > div > div {
    max-width: 720px;
    color: #e9f4ff;
  }
  .cms-media-hero a {
    flex: 0 0 auto;
    border: 1px solid #ffffff70;
    border-radius: 8px;
    padding: 9px 13px;
    background: #ffffff12;
    color: #fff !important;
    font-size: 14px;
    font-weight: 700;
  }
  .cms-media-hero a:hover {
    background: #fff;
    color: #175486 !important;
  }
  .cms-media-page #supabase-user-info,
  .cms-media-page #supabase-signout {
    display: none !important;
  }
  .cms-media-status {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
    padding: 17px 20px;
    border: 1px solid var(--cms-border);
    border-radius: 12px;
    background: var(--cms-panel);
    color: var(--cms-muted);
  }
  .cms-media-status[data-kind='success'] {
    border-color: #abefc6;
    background: #ecfdf3;
    color: #067647;
  }
  .cms-media-status[data-kind='error'] {
    border-color: #fecdca;
    background: #fef3f2;
    color: #b42318;
  }
  .cms-media-status[data-kind='loading']::before {
    width: 17px;
    height: 17px;
    border: 2px solid var(--cms-border);
    border-top-color: var(--cms-blue);
    border-radius: 50%;
    animation: cms-media-spin 0.8s linear infinite;
    content: '';
  }
  .cms-media-spinner {
    width: 17px;
    height: 17px;
    border: 2px solid var(--cms-border);
    border-top-color: var(--cms-blue);
    border-radius: 50%;
    animation: cms-media-spin 0.8s linear infinite;
  }
  .cms-media-status[data-kind] .cms-media-spinner {
    display: none;
  }
  @keyframes cms-media-spin {
    to {
      transform: rotate(360deg);
    }
  }
  .cms-media-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin: 22px 0;
  }
  .cms-media-stats article {
    display: flex;
    align-items: center;
    gap: 13px;
    min-width: 0;
    padding: 18px;
    border: 1px solid var(--cms-border);
    border-radius: 14px;
    background: var(--cms-panel);
    box-shadow: 0 8px 20px #1018280a;
  }
  .cms-media-stat-icon {
    display: grid;
    flex: 0 0 42px;
    height: 42px;
    place-items: center;
    border-radius: 11px;
    box-sizing: border-box;
    padding: 6px;
  }
  .cms-media-stat-icon svg {
    display: block;
    flex: 0 0 auto;
    width: 100%;
    height: 100%;
  }
  .cms-media-stat-blue {
    background: #e8f2fb;
    color: #287bb8;
  }
  .cms-media-stat-green {
    background: #e8f7ef;
    color: #18794e;
  }
  .cms-media-stat-purple {
    background: #f0eafe;
    color: #6941c6;
  }
  .cms-media-stat-amber {
    background: #fff4df;
    color: #b54708;
  }
  .cms-media-stats strong,
  .cms-media-stats span {
    display: block;
  }
  .cms-media-stats strong {
    font-size: 24px;
    line-height: 1;
  }
  .cms-media-stats article div span {
    margin-top: 5px;
    overflow: hidden;
    color: var(--cms-muted);
    font-size: 12px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cms-media-upload,
  .cms-media-library {
    border: 1px solid var(--cms-border);
    border-radius: 18px;
    background: var(--cms-panel);
    box-shadow: 0 14px 35px #10182810;
  }
  .cms-media-upload {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 22px;
    padding: 20px 24px;
  }
  .cms-media-upload-copy {
    display: flex;
    align-items: center;
    gap: 13px;
    min-width: 0;
  }
  .cms-media-upload-copy > span {
    display: grid;
    flex: 0 0 42px;
    height: 42px;
    place-items: center;
    border-radius: 12px;
    background: #e8f2fb;
    color: var(--cms-blue);
    font-size: 22px;
    font-weight: 800;
  }
  .cms-media-upload h2 {
    margin: 0 0 4px;
    color: var(--cms-text);
    font-size: 21px;
  }
  .cms-media-upload p {
    margin: 0;
    color: var(--cms-muted);
    font-size: 13px;
  }
  .cms-media-upload-controls,
  .cms-media-tools,
  .cms-media-actions {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .cms-media-file-picker {
    display: inline-flex;
    align-items: center;
    max-width: 280px;
    height: 42px;
    box-sizing: border-box;
    border: 1px solid var(--cms-border);
    border-radius: 9px;
    padding: 0 13px;
    background: color-mix(in srgb, var(--cms-bg) 42%, var(--cms-panel));
    color: var(--cms-text);
    cursor: pointer;
  }
  .cms-media-file-picker input {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
  .cms-media-metadata {
    display: grid;
    flex: 1 0 100%;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin: 2px 0 0;
    border: 1px solid var(--cms-border);
    border-radius: 12px;
    padding: 14px;
  }
  .cms-media-metadata legend {
    padding: 0 6px;
    color: var(--cms-text);
    font-size: 13px;
    font-weight: 750;
  }
  .cms-media-metadata label:not(.cms-media-decorative) {
    display: grid;
    gap: 5px;
    color: var(--cms-text);
    font-size: 12px;
    font-weight: 650;
  }
  .cms-media-metadata input[type='text'],
  .cms-media-metadata textarea {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid var(--cms-border);
    border-radius: 8px;
    padding: 9px 10px;
    background: var(--cms-panel);
    color: var(--cms-text);
    font: inherit;
    font-weight: 400;
  }
  .cms-media-metadata small {
    color: var(--cms-muted);
    font-weight: 400;
  }
  .cms-media-decorative {
    display: flex;
    grid-column: 1 / -1;
    align-items: center;
    gap: 7px;
    color: var(--cms-text);
    font-size: 13px;
  }
  .cms-media-file-picker span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cms-media-upload button,
  .cms-media-tools button,
  .cms-media-actions button {
    height: 40px;
    border: 0;
    border-radius: 8px;
    padding: 0 14px;
    background: var(--cms-blue);
    color: #fff;
    font: inherit;
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
  }
  .cms-media-upload button:disabled,
  .cms-media-tools button:disabled,
  .cms-media-actions button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }
  .cms-media-library {
    overflow: hidden;
  }
  .cms-media-library-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 22px;
    padding: 22px 24px;
    border-bottom: 1px solid var(--cms-border);
  }
  .cms-media-library-header p {
    color: var(--cms-blue);
  }
  .cms-media-library-header h2 {
    margin: 0 0 3px;
    color: var(--cms-text);
    font-size: 23px;
  }
  .cms-media-library-header span {
    color: var(--cms-muted);
    font-size: 13px;
  }
  .cms-media-tools input {
    width: 260px;
    height: 40px;
    box-sizing: border-box;
    border: 1px solid var(--cms-border);
    border-radius: 9px;
    padding: 0 12px;
    background: var(--cms-panel);
    color: var(--cms-text);
    font: inherit;
  }
  .cms-media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
    gap: 16px;
    padding: 22px 24px 24px;
  }
  .cms-media-card {
    overflow: hidden;
    border: 1px solid var(--cms-border);
    border-radius: 14px;
    background: var(--cms-panel);
    box-shadow: 0 8px 18px #1018280d;
  }
  .cms-media-preview {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    background:
      linear-gradient(45deg, color-mix(in srgb, var(--cms-bg) 82%, #fff) 25%, transparent 25%) 0 0 /
        18px 18px,
      linear-gradient(45deg, transparent 75%, color-mix(in srgb, var(--cms-bg) 82%, #fff) 75%) 0 0 /
        18px 18px,
      var(--cms-bg);
  }
  .cms-media-preview > strong {
    color: var(--cms-muted);
    letter-spacing: 0.12em;
  }
  .cms-media-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cms-media-card-body {
    padding: 13px;
  }
  .cms-media-card-meta strong,
  .cms-media-card-meta span {
    display: block;
  }
  .cms-media-card-meta strong {
    overflow: hidden;
    color: var(--cms-text);
    font-size: 13px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .cms-media-card-meta span {
    margin-top: 4px;
    color: var(--cms-muted);
    font-size: 12px;
  }
  .cms-media-actions {
    justify-content: space-between;
    margin-top: 13px;
  }
  .cms-media-actions button {
    flex: 1 1 auto;
    height: 36px;
    padding: 0 10px;
  }
  .cms-media-actions .cms-media-delete {
    border: 1px solid #fecdca;
    background: #fef3f2;
    color: #b42318;
  }
  .cms-media-empty {
    padding: 48px 20px 52px;
    border-top: 1px solid var(--cms-border);
    color: var(--cms-muted);
    text-align: center;
  }
  .cms-media-empty span {
    display: block;
    margin-bottom: 8px;
    color: var(--cms-blue);
    font-size: 32px;
  }
  .cms-media-empty strong {
    display: block;
    color: var(--cms-text);
    font-size: 18px;
  }
  .cms-media-empty p {
    margin: 6px 0 0;
  }
  .cms-media-page .hidden {
    display: none !important;
  }
  [data-theme='dark'] .cms-media-status[data-kind='success'] {
    border-color: #18794e;
    background: #103522;
    color: #abefc6;
  }
  [data-theme='dark'] .cms-media-status[data-kind='error'],
  [data-theme='dark'] .cms-media-actions .cms-media-delete {
    border-color: #7a271a;
    background: #3f1511;
    color: #fecdca;
  }
  @media (max-width: 900px) {
    .cms-media-page {
      padding: 20px;
    }
    .cms-media-hero,
    .cms-media-upload,
    .cms-media-library-header {
      flex-direction: column;
      align-items: stretch;
    }
    .cms-media-stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .cms-media-tools,
    .cms-media-upload-controls {
      align-items: stretch;
      flex-direction: column;
    }
    .cms-media-tools input,
    .cms-media-file-picker {
      width: 100%;
      max-width: none;
    }
  }
  @media (max-width: 560px) {
    .cms-media-page {
      padding: 14px;
    }
    .cms-media-hero {
      padding: 24px;
    }
    .cms-media-stats {
      grid-template-columns: 1fr;
    }
    .cms-media-grid {
      grid-template-columns: 1fr;
      padding: 18px;
    }
  }
</style>
