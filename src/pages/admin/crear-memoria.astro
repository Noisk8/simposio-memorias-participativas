---
import AdminLayout from '../../layouts/AdminLayout.astro';
import SupabaseAuth from '../../components/SupabaseAuth.astro';
---

<AdminLayout title="Crear memoria - Admin">
  <section class="py-16 bg-white min-h-[60vh]">
    <div class="max-w-2xl mx-auto px-4">
      <h1
        class="text-3xl font-bold mb-6 text-ugr-green-dark font-[family-name:var(--font-heading)]"
      >
        Crear nueva memoria
      </h1>
      <p class="text-ugr-text-light mb-8">
        Solo los usuarios con rol <strong>admin</strong> pueden crear memorias desde aquí. El cambio se
        guardará en el repositorio y Netlify desplegará el sitio automáticamente.
      </p>

      <SupabaseAuth redirectUnauthenticated />

      <div id="not-allowed" class="hidden bg-red-50 text-red-700 p-4 rounded-lg mb-6">
        No tienes permiso para crear memorias. Inicia sesión con una cuenta de administrador.
      </div>

      <div id="loading" class="text-ugr-text-light mb-6">Verificando sesión...</div>

      <form id="memoria-form" class="hidden space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-semibold text-ugr-text mb-1" for="number">Número</label
            >
            <input
              type="number"
              id="number"
              name="number"
              required
              class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green"
            />
          </div>
          <div>
            <label class="block text-sm font-semibold text-ugr-text mb-1" for="title">Título</label>
            <input
              type="text"
              id="title"
              name="title"
              required
              class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green"
            />
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-ugr-text mb-1" for="place">Lugar</label>
          <input
            type="text"
            id="place"
            name="place"
            required
            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green"
          />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-semibold text-ugr-text mb-1" for="author"
              >Autor/a</label
            >
            <input
              type="text"
              id="author"
              name="author"
              class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green"
            />
          </div>
          <div>
            <label class="block text-sm font-semibold text-ugr-text mb-1" for="collective"
              >Colectivo</label
            >
            <input
              type="text"
              id="collective"
              name="collective"
              class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green"
            />
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-ugr-text mb-1" for="image">Imagen</label>
          <input
            type="text"
            id="image"
            name="image"
            required
            placeholder="/images/memoria-30.jpg"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green"
          />
          <p class="text-xs text-ugr-text-light mt-1">
            Sube la imagen a <code>/public/images/</code> y escribe la ruta pública, por ejemplo <code
              >/images/memoria-30.jpg</code
            >.
          </p>
        </div>

        <div>
          <label class="block text-sm font-semibold text-ugr-text mb-1" for="description"
            >Descripción corta</label
          >
          <textarea
            id="description"
            name="description"
            rows="3"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green"
          ></textarea>
        </div>

        <div>
          <label class="block text-sm font-semibold text-ugr-text mb-1" for="body"
            >Texto completo (Markdown)</label
          >
          <textarea
            id="body"
            name="body"
            rows="8"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green font-mono text-sm"
          ></textarea>
        </div>

        <div class="flex items-center gap-4">
          <button type="submit" class="btn-green"> Crear memoria </button>
          <span id="status" class="text-sm font-medium"></span>
        </div>
      </form>
    </div>
  </section>
</AdminLayout>

<script is:inline>
  // @ts-nocheck
  const form = document.getElementById('memoria-form');
  const notAllowed = document.getElementById('not-allowed');
  const loading = document.getElementById('loading');
  const status = document.getElementById('status');

  function waitForAuth(callback) {
    if (window.supabaseAuth) {
      callback(window.supabaseAuth);
      return;
    }
    var attempts = 0;
    var interval = setInterval(function () {
      attempts++;
      if (window.supabaseAuth) {
        clearInterval(interval);
        callback(window.supabaseAuth);
      } else if (attempts > 60) {
        clearInterval(interval);
        loading.textContent = 'No se pudo cargar la autenticación.';
      }
    }, 100);
  }

  async function getToken() {
    var auth = window.supabaseAuth;
    return auth ? await auth.getToken() : null;
  }

  waitForAuth(function (auth) {
    function refresh() {
      auth.getUser().then(function (user) {
        loading.classList.add('hidden');
        if (!user) {
          form.classList.add('hidden');
          notAllowed.classList.add('hidden');
          return;
        }

        // El acceso real lo valida la Netlify Function; aquí solo mostramos el formulario.
        form.classList.remove('hidden');
        notAllowed.classList.add('hidden');
      });
    }

    auth.ready.then(refresh);
    window.addEventListener('supabase-auth', refresh);
  });

  form?.addEventListener('submit', async function (e) {
    e.preventDefault();
    status.textContent = 'Enviando...';
    status.className = 'text-sm font-medium text-ugr-text-light';

    var token = await getToken();
    if (!token) {
      status.textContent = 'No se encontró el token de sesión.';
      status.className = 'text-sm font-medium text-red-600';
      return;
    }

    var data = {
      number: parseInt(document.getElementById('number').value, 10),
      title: document.getElementById('title').value,
      place: document.getElementById('place').value,
      author: document.getElementById('author').value,
      collective: document.getElementById('collective').value,
      image: document.getElementById('image').value,
      description: document.getElementById('description').value,
      body: document.getElementById('body').value,
    };

    try {
      var response = await fetch('/.netlify/functions/manage-content?collection=memorias', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: 'Bearer ' + token,
        },
        body: JSON.stringify({
          data: {
            draft: true,
            simposio: '2026',
            number: data.number,
            title: data.title,
            place: data.place,
            author: data.author,
            collective: data.collective,
            categories: [],
            tags: [],
            image: data.image,
            description: data.description,
          },
          body: data.body,
        }),
      });

      var result = await response.json();

      if (response.ok) {
        status.textContent = 'Memoria creada. Redesplegando...';
        status.className = 'text-sm font-medium text-green-600';
        form.reset();
      } else {
        status.textContent = (result.error && result.error.message) || 'Error al crear la memoria.';
        status.className = 'text-sm font-medium text-red-600';
      }
    } catch (err) {
      status.textContent = 'Error de red: ' + err.message;
      status.className = 'text-sm font-medium text-red-600';
    }
  });
</script>
