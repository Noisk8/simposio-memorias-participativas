---
import AdminLayout from '../../layouts/AdminLayout.astro';
import SupabaseAuth from '../../components/SupabaseAuth.astro';
---

<AdminLayout title="Crear memoria - Admin">
  <section class="py-16 bg-white min-h-[60vh]">
    <div class="max-w-2xl mx-auto px-4">
      <h1
        class="text-3xl font-bold mb-6 text-ugr-green-dark font-[family-name:var(--font-heading)]"
      >
        Crear nueva memoria
      </h1>
      <p class="text-ugr-text-light mb-8">
        Solo los usuarios con rol <strong>admin</strong> pueden crear memorias desde aquí. El cambio se
        guardará en el repositorio y Netlify desplegará el sitio automáticamente.
      </p>

      <SupabaseAuth redirectUnauthenticated />

      <div id="not-allowed" class="hidden bg-red-50 text-red-700 p-4 rounded-lg mb-6">
        No tienes permiso para crear memorias. Inicia sesión con una cuenta de administrador.
      </div>

      <div id="loading" class="text-ugr-text-light mb-6">Verificando sesión...</div>

      <form id="memoria-form" class="hidden space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-semibold text-ugr-text mb-1" for="number">Número</label
            >
            <input
              type="number"
              id="number"
              name="number"
              required
              class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green"
            />
          </div>
          <div>
            <label class="block text-sm font-semibold text-ugr-text mb-1" for="title">Título</label>
            <input
              type="text"
              id="title"
              name="title"
              required
              class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green"
            />
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-ugr-text mb-1" for="place">Lugar</label>
          <input
            type="text"
            id="place"
            name="place"
            required
            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green"
          />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-semibold text-ugr-text mb-1" for="author"
              >Autor/a</label
            >
            <input
              type="text"
              id="author"
              name="author"
              class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green"
            />
          </div>
          <div>
            <label class="block text-sm font-semibold text-ugr-text mb-1" for="collective"
              >Colectivo</label
            >
            <input
              type="text"
              id="collective"
              name="collective"
              class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green"
            />
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-ugr-text mb-1" for="image">Imagen</label>
          <input
            type="text"
            id="image"
            name="image"
            required
            placeholder="/images/proyecto-30.jpg"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green"
          />
          <p class="text-xs text-ugr-text-light mt-1">
            Sube la imagen desde el editor o la Biblioteca de medios y guarda la URL pública
            devuelta por Supabase Storage. Las rutas históricas <code>/images/…</code> siguen funcionando
            durante la migración.
          </p>
        </div>

        <div>
          <label class="block text-sm font-semibold text-ugr-text mb-1" for="description"
            >Descripción corta</label
          >
          <textarea
            id="description"
            name="description"
            rows="3"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green"
          ></textarea>
        </div>

        <div>
          <label class="block text-sm font-semibold text-ugr-text mb-1" for="body"
            >Texto completo (Markdown)</label
          >
          <textarea
            id="body"
            name="body"
            rows="8"
            class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green font-mono text-sm"
          ></textarea>
        </div>

        <div class="flex items-center gap-4">
          <button type="submit" class="btn-green"> Crear memoria </button>
          <span id="status" class="text-sm font-medium"></span>
        </div>
      </form>
    </div>
  </section>
</AdminLayout>

<script src="../../scripts/admin/quick-memory.ts"></script>
