---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Crear proyecto - Admin">
  <section class="py-16 bg-white min-h-[60vh]">
    <div class="max-w-2xl mx-auto px-4">
      <h1 class="text-3xl font-bold mb-6 text-ugr-green-dark font-[family-name:var(--font-heading)]">
        Crear nuevo proyecto
      </h1>
      <p class="text-ugr-text-light mb-8">
        Solo los usuarios con rol <strong>admin</strong> pueden crear proyectos desde aquí. El cambio se guardará en el repositorio y Netlify desplegará el sitio automáticamente.
      </p>

      <div id="not-allowed" class="hidden bg-red-50 text-red-700 p-4 rounded-lg mb-6">
        No tienes permiso para crear proyectos. Inicia sesión con una cuenta de administrador.
      </div>

      <div id="loading" class="text-ugr-text-light mb-6">
        Verificando sesión...
      </div>

      <form id="proyecto-form" class="hidden space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-semibold text-ugr-text mb-1" for="number">Número</label>
            <input type="number" id="number" name="number" required class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-ugr-text mb-1" for="title">Título</label>
            <input type="text" id="title" name="title" required class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-ugr-text mb-1" for="place">Lugar</label>
          <input type="text" id="place" name="place" required class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green" />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-semibold text-ugr-text mb-1" for="author">Autor/a</label>
            <input type="text" id="author" name="author" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green" />
          </div>
          <div>
            <label class="block text-sm font-semibold text-ugr-text mb-1" for="collective">Colectivo</label>
            <input type="text" id="collective" name="collective" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-ugr-text mb-1" for="image">Imagen</label>
          <input type="text" id="image" name="image" required placeholder="/images/proyecto-30.jpg" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green" />
          <p class="text-xs text-ugr-text-light mt-1">
            Sube la imagen a <code>/public/images/</code> y escribe la ruta pública, por ejemplo <code>/images/proyecto-30.jpg</code>.
          </p>
        </div>

        <div>
          <label class="block text-sm font-semibold text-ugr-text mb-1" for="description">Descripción corta</label>
          <textarea id="description" name="description" rows="3" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green"></textarea>
        </div>

        <div>
          <label class="block text-sm font-semibold text-ugr-text mb-1" for="body">Texto completo (Markdown)</label>
          <textarea id="body" name="body" rows="8" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green font-mono text-sm"></textarea>
        </div>

        <div class="flex items-center gap-4">
          <button type="submit" class="btn-green">
            Crear proyecto
          </button>
          <span id="status" class="text-sm font-medium"></span>
        </div>
      </form>
    </div>
  </section>
</Layout>

<script is:inline>
  // @ts-nocheck
  const form = document.getElementById('proyecto-form');
  const notAllowed = document.getElementById('not-allowed');
  const loading = document.getElementById('loading');
  const status = document.getElementById('status');

  function waitForIdentity(callback) {
    if (window.netlifyIdentity) {
      callback(window.netlifyIdentity);
      return;
    }
    var attempts = 0;
    var interval = setInterval(function () {
      attempts++;
      if (window.netlifyIdentity) {
        clearInterval(interval);
        callback(window.netlifyIdentity);
      } else if (attempts > 60) {
        clearInterval(interval);
        loading.textContent = 'No se pudo cargar la autenticación.';
      }
    }, 100);
  }

  function isAdmin(user) {
    if (!user) return false;
    var metadata = user.app_metadata || user.user_metadata || {};
    var roles = metadata.roles || user.roles || [];
    return roles.includes('admin');
  }

  function getUserName(user) {
    var metadata = user.user_metadata || user.app_metadata || {};
    return metadata.full_name || metadata.name || user.email;
  }

  waitForIdentity(function (identity) {
    var user = identity.currentUser();

    if (!user) {
      loading.classList.add('hidden');
      notAllowed.classList.remove('hidden');
      notAllowed.textContent = 'Debes iniciar sesión para acceder.';
      return;
    }

    if (!isAdmin(user)) {
      loading.classList.add('hidden');
      notAllowed.classList.remove('hidden');
      notAllowed.textContent = 'Hola ' + getUserName(user) + '. No tienes rol de administrador.';
      return;
    }

    loading.classList.add('hidden');
    form.classList.remove('hidden');
  });

  form?.addEventListener('submit', async function (e) {
    e.preventDefault();
    status.textContent = 'Enviando...';
    status.className = 'text-sm font-medium text-ugr-text-light';

    var identity = window.netlifyIdentity;
    var user = identity?.currentUser?.();
    if (!user || !isAdmin(user)) {
      status.textContent = 'No tienes permiso.';
      status.className = 'text-sm font-medium text-red-600';
      return;
    }

    var token = user.token?.access_token;
    if (!token) {
      status.textContent = 'No se encontró el token de sesión.';
      status.className = 'text-sm font-medium text-red-600';
      return;
    }

    var data = {
      number: parseInt(document.getElementById('number').value, 10),
      title: document.getElementById('title').value,
      place: document.getElementById('place').value,
      author: document.getElementById('author').value,
      collective: document.getElementById('collective').value,
      image: document.getElementById('image').value,
      description: document.getElementById('description').value,
      body: document.getElementById('body').value,
    };

    try {
      var response = await fetch('/.netlify/functions/create-proyecto', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + token,
        },
        body: JSON.stringify(data),
      });

      var result = await response.json();

      if (response.ok) {
        status.textContent = 'Proyecto creado. Redesplegando...';
        status.className = 'text-sm font-medium text-green-600';
        form.reset();
      } else {
        status.textContent = result.error || 'Error al crear el proyecto.';
        status.className = 'text-sm font-medium text-red-600';
      }
    } catch (err) {
      status.textContent = 'Error de red: ' + err.message;
      status.className = 'text-sm font-medium text-red-600';
    }
  });
</script>
