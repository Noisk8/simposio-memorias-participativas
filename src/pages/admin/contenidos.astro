---
import AdminLayout from '../../layouts/AdminLayout.astro';
import SupabaseAuth from '../../components/SupabaseAuth.astro';
---

<AdminLayout title="Gestión de contenidos - Admin">
  <section class="cms-shell">
    <div class="cms-page">
      <div class="cms-mobile-heading">
        <div>
          <a href="/admin/" class="text-sm text-ugr-green hover:underline">← Panel</a>
          <h1 class="mt-2 text-3xl font-bold text-ugr-green-dark">Gestión de contenidos</h1>
          <p class="mt-2 text-ugr-text-light">
            Edición protegida con sesión y permisos de Supabase.
          </p>
        </div>
        <button
          id="new-button"
          class="rounded-lg bg-ugr-green px-5 py-2.5 font-semibold text-white hover:opacity-90"
          >Nuevo contenido</button
        >
      </div>

      <SupabaseAuth redirectUnauthenticated />
      <div id="status" class="mb-5 rounded-lg bg-white p-4 text-sm text-ugr-text-light shadow-sm">
        Verificando sesión…
      </div>

      <div id="workspace" class="cms-workspace hidden">
        <aside class="cms-sidebar">
          <select id="collection" class="sr-only">
            <option value="entradas">Entradas</option>
            <option value="memorias">Memorias</option>
            <option value="paginas">Páginas</option>
            <option value="simposios">Simposios</option>
            <option value="categorias">Categorías</option>
            <option value="etiquetas">Etiquetas</option>
          </select>
          <label for="search" class="sr-only">Buscar</label>
          <input
            id="search"
            type="search"
            placeholder="Buscar en todo el CMS…"
            class="cms-search"
          />
          <p class="cms-side-title">CONTENIDO</p>
          <nav id="collection-nav" class="cms-side-nav"></nav>
          <div class="cms-side-divider"></div>
          <p class="cms-side-title">BORRADORES</p>
          <button type="button" class="cms-draft-link" data-draft-collection="entradas"
            >✎ Borradores · Entradas</button
          >
          <button type="button" class="cms-draft-link" data-draft-collection="memorias"
            >✎ Borradores · Memorias</button
          >
          <button type="button" class="cms-draft-link" data-draft-collection="paginas"
            >✎ Borradores · Páginas</button
          >
          <label class="mb-4 flex items-center gap-2 text-sm"
            ><input id="drafts-only" type="checkbox" /> Solo borradores</label
          >
          <div class="hidden">
            <select
              id="sort"
              class="min-w-0 flex-1 rounded-lg border border-gray-300 px-2 py-2 text-sm"
            >
              <option value="title">Ordenar: título</option>
              <option value="date">Ordenar: fecha</option>
              <option value="number">Ordenar: número</option>
            </select>
            <button
              id="view-list"
              type="button"
              title="Vista de lista"
              class="rounded border border-gray-300 px-3">☰</button
            >
            <button
              id="view-grid"
              type="button"
              title="Vista de cuadrícula"
              class="rounded border border-gray-300 px-3">▦</button
            >
          </div>
        </aside>

        <main class="cms-content">
          <section id="collection-view">
            <header class="cms-collection-header">
              <div>
                <h1 id="collection-title">Entradas</h1><p id="collection-description"></p>
              </div><button id="header-new-button" type="button" class="cms-primary"
                >＋ Nueva entrada</button
              >
            </header>
            <div class="cms-list-toolbar">
              <span id="deploy-status" class="cms-deploy-status">Despliegue: consultando…</span>
              <select id="sort-visible"
                ><option value="title">Sort by · Título</option><option value="date"
                  >Sort by · Fecha</option
                ><option value="number">Sort by · Número</option></select
              ><select id="group"><option value="">Group by</option></select><button
                id="view-list-visible"
                type="button">☰</button
              ><button id="view-grid-visible" type="button">▦</button>
            </div>
            <div id="items" class="cms-cards"></div>
          </section>
          <div id="empty-editor" class="hidden"></div>
          <form id="editor" class="hidden">
            <div
              class="mb-5 flex flex-wrap items-center justify-between gap-3 border-b border-gray-200 pb-4"
            >
              <div>
                <h2 id="editor-title" class="text-2xl font-semibold text-ugr-green-dark">
                  Nuevo contenido
                </h2>
                <p id="file-path" class="mt-1 text-xs text-gray-500"></p>
                <div
                  id="version-info"
                  class="mt-3 hidden rounded-lg border border-gray-200 bg-gray-50 p-3 text-xs"
                >
                </div>
              </div>
              <div class="flex gap-2">
                <span id="save-state" class="self-center text-xs text-gray-500">Sin cambios</span>
                <button
                  type="button"
                  id="back-button"
                  class="rounded-lg border border-gray-300 px-4 py-2 text-sm">← Volver</button
                >
                <button
                  type="button"
                  id="history-button"
                  class="hidden rounded-lg border border-gray-300 px-4 py-2 text-sm hover:bg-gray-50"
                  >Historial</button
                >
                <button
                  type="button"
                  id="delete-button"
                  class="hidden rounded-lg border border-red-300 px-4 py-2 text-sm text-red-700 hover:bg-red-50"
                  >Eliminar</button
                >
                <button
                  type="button"
                  id="save-draft-button"
                  class="rounded-lg border border-ugr-green px-4 py-2 text-sm font-semibold text-ugr-green hover:bg-green-50"
                  >Guardar borrador</button
                >
                <button
                  type="button"
                  id="publish-button"
                  class="rounded-lg bg-ugr-green px-5 py-2 text-sm font-semibold text-white hover:opacity-90"
                  >Publicar</button
                >
                <button
                  type="button"
                  id="archive-button"
                  class="hidden rounded-lg border border-amber-600 px-4 py-2 text-sm font-semibold text-amber-800 hover:bg-amber-50"
                  >Archivar</button
                >
              </div>
            </div>
            <div class="grid grid-cols-1 gap-6 xl:grid-cols-2">
              <div>
                <div id="fields" class="grid grid-cols-1 gap-4 md:grid-cols-2"></div>
                <div id="content-block-editor" class="cms-content-block-editor mt-5">
                  <aside
                    id="content-block-tools"
                    class="cms-block-tools hidden"
                    aria-label="Herramientas de contenido"
                  >
                    <div>
                      <strong>Bloques</strong>
                      <p>Añade elementos en la posición del cursor.</p>
                    </div>
                    <button type="button" data-block-action="image"
                      ><span aria-hidden="true">▧</span> Imagen</button
                    >
                    <button type="button" data-block-action="gallery"
                      ><span aria-hidden="true">▦</span> Galería</button
                    >
                    <button type="button" data-block-action="carousel"
                      ><span aria-hidden="true">↔</span> Carrusel</button
                    >
                    <button type="button" data-block-action="entries"
                      ><span aria-hidden="true">▤</span> Entradas</button
                    >
                    <button type="button" data-block-action="quote"
                      ><span aria-hidden="true">❝</span> Cita</button
                    >
                  </aside>
                  <div class="cms-markdown-editor">
                    <label for="body" class="mb-1 block text-sm font-semibold"
                      >Contenido (Markdown)</label
                    >
                    <textarea
                      id="body"
                      rows="18"
                      class="w-full rounded-lg border border-gray-300 px-3 py-2 font-mono text-sm"
                      placeholder="Escribe aquí el contenido…"></textarea>
                    <p class="cms-editor-help">
                      También puedes escribir Markdown directamente. Los bloques se pueden mover
                      junto con el texto.
                    </p>
                  </div>
                </div>
              </div>
              <aside class="xl:sticky xl:top-5 xl:self-start">
                <div class="mb-2 flex items-center justify-between">
                  <h3 class="font-semibold">Vista previa en tiempo real</h3>
                  <span class="rounded-full bg-green-100 px-2 py-1 text-xs text-green-800"
                    >En vivo</span
                  >
                </div>
                <article
                  id="live-preview"
                  class="min-h-96 overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm"
                >
                </article>
              </aside>
            </div>
          </form>
          <section id="history" class="hidden"></section>
        </main>
      </div>
    </div>

    <div
      id="media-library-dialog"
      class="cms-media-picker hidden"
      role="dialog"
      aria-modal="true"
      aria-labelledby="media-library-title"
    >
      <button
        type="button"
        class="cms-media-picker-backdrop"
        data-close-media-picker
        aria-label="Cerrar biblioteca de imágenes"></button>
      <section class="cms-media-picker-panel">
        <header class="cms-media-picker-header">
          <div>
            <p>Biblioteca de medios</p>
            <h2 id="media-library-title">Elegir una imagen</h2>
          </div>
          <button type="button" class="cms-media-picker-close" data-close-media-picker>
            <span aria-hidden="true">×</span><span class="sr-only">Cerrar</span>
          </button>
        </header>
        <div class="cms-media-picker-tools">
          <label>
            <span class="sr-only">Buscar imágenes</span>
            <input
              id="media-library-search"
              type="search"
              placeholder="Buscar por nombre, crédito o licencia…"
              autocomplete="off"
            />
          </label>
          <button id="media-library-refresh" type="button">↻ Actualizar</button>
        </div>
        <p id="media-library-status" class="cms-media-picker-status" aria-live="polite">
          Cargando biblioteca…
        </p>
        <div id="media-library-grid" class="cms-media-picker-grid"></div>
        <footer id="media-library-selection" class="cms-media-picker-selection hidden">
          <span id="media-library-selection-count">0 imágenes seleccionadas</span>
          <button id="media-library-insert-selection" type="button" disabled
            >Insertar selección</button
          >
        </footer>
      </section>
    </div>

    <div
      id="entries-block-dialog"
      class="cms-media-picker hidden"
      role="dialog"
      aria-modal="true"
      aria-labelledby="entries-block-title"
    >
      <button
        type="button"
        class="cms-media-picker-backdrop"
        data-close-entries-block
        aria-label="Cerrar configuración"></button>
      <section class="cms-block-dialog-panel">
        <header class="cms-media-picker-header">
          <div>
            <p>Bloque dinámico</p>
            <h2 id="entries-block-title">Entradas por categoría</h2>
          </div>
          <button type="button" class="cms-media-picker-close" data-close-entries-block>
            <span aria-hidden="true">×</span><span class="sr-only">Cerrar</span>
          </button>
        </header>
        <div class="cms-block-dialog-fields">
          <label>
            <span>Categoría</span>
            <select id="entries-block-category"></select>
          </label>
          <label>
            <span>Número de entradas</span>
            <input id="entries-block-limit" type="number" min="1" max="12" value="6" />
          </label>
          <label>
            <span>Presentación</span>
            <select id="entries-block-layout">
              <option value="grid">Cuadrícula</option>
              <option value="carousel">Carrusel horizontal</option>
            </select>
          </label>
        </div>
        <footer class="cms-block-dialog-actions">
          <button type="button" data-close-entries-block>Cancelar</button>
          <button id="entries-block-insert" type="button">Insertar bloque</button>
        </footer>
      </section>
    </div>
  </section>
</AdminLayout>

<script src="../../scripts/admin/content-editor.ts"></script>

<style is:global>
  .cms-shell {
    min-height: calc(100vh - 54px);
    background: var(--cms-bg);
  }
  .cms-page {
    padding: 10px 24px 40px;
  }
  .cms-mobile-heading,
  #supabase-user-info,
  #supabase-signout {
    display: none !important;
  }
  .cms-api-status {
    display: none;
  }
  .cms-api-status.cms-api-error {
    display: block;
    position: fixed;
    left: 290px;
    right: 24px;
    top: 65px;
    z-index: 45;
    border: 1px solid #fca5a5;
    background: #fef2f2 !important;
    color: #b91c1c !important;
  }
  .cms-workspace {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: 22px;
    align-items: start;
  }
  .cms-sidebar {
    position: sticky;
    top: 64px;
    height: calc(100vh - 84px);
    overflow: auto;
    background: var(--cms-side);
    border: 1px solid var(--cms-border);
    border-radius: 16px;
    padding: 18px 14px;
    box-sizing: border-box;
    box-shadow: 0 12px 35px #10182812;
  }
  .cms-search {
    width: 100%;
    height: 43px;
    box-sizing: border-box;
    border: 1px solid var(--cms-border);
    border-radius: 11px;
    background: var(--cms-panel);
    color: var(--cms-text);
    padding: 0 13px;
    margin: 31px 0 28px;
  }
  .cms-side-title {
    margin: 0 6px 8px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--cms-text);
  }
  .cms-side-nav {
    display: block !important;
  }
  .cms-side-nav button,
  .cms-side-nav a,
  .cms-draft-link {
    display: flex;
    width: 100%;
    align-items: center;
    gap: 11px;
    border: 0;
    background: transparent;
    color: var(--cms-text);
    padding: 9px 14px;
    text-align: left;
    font: inherit;
    cursor: pointer;
    border-radius: 0;
  }
  .cms-side-nav button:hover,
  .cms-side-nav a:hover,
  .cms-draft-link:hover {
    background: #dfe7f1;
  }
  .cms-side-nav button.active {
    background: #dce5f1;
    color: #2679b8;
  }
  .cms-side-divider {
    height: 1px;
    background: var(--cms-border);
    margin: 14px 3px 26px;
  }
  .cms-content {
    min-width: 0;
    padding: 0 0 80px;
  }
  .cms-collection-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 22px;
    max-width: 680px;
    min-height: 120px;
    box-sizing: border-box;
    margin: 0 12px 22px;
    background: var(--cms-panel);
    border: 1px solid #d9dee6;
    border-radius: 18px;
    padding: 20px;
    box-shadow: 0 12px 30px #1018280c;
  }
  .cms-collection-header h1 {
    font-family: var(--font-montserrat), sans-serif;
    font-size: 25px;
    margin: 0 0 14px;
    color: var(--cms-text);
  }
  .cms-collection-header p {
    max-width: 520px;
    margin: 0;
    color: var(--cms-text);
    line-height: 1.45;
  }
  .cms-primary,
  .cms-editor-action,
  .cms-list-toolbar button,
  .cms-list-toolbar select {
    border: 0;
    border-radius: 6px;
    background: var(--cms-blue);
    color: #fff;
    padding: 10px 14px;
    font: inherit;
    cursor: pointer;
  }
  .cms-primary {
    min-width: 130px;
  }
  .cms-editor-action {
    border: 1px solid var(--cms-blue);
    border-radius: 7px;
    background: var(--cms-panel);
    color: var(--cms-blue);
    padding: 8px 13px;
  }
  .cms-list-toolbar {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
    margin: 0 24px 16px;
  }
  .cms-deploy-status {
    align-self: center;
    margin-right: auto;
    color: var(--cms-muted);
    font-size: 13px;
  }
  .cms-deploy-status[data-state='success'] {
    color: #18794e;
  }
  .cms-deploy-status[data-state='failure'],
  .cms-deploy-status[data-state='error'] {
    color: #b42318;
  }
  .cms-list-toolbar button {
    font-size: 20px;
    padding: 4px 8px;
    background: var(--cms-panel);
    color: var(--cms-text);
    border: 1px solid #e4e7ec;
  }
  .cms-cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 335px));
    gap: 16px;
    padding: 0 0 30px;
  }
  .cms-cards.list-view {
    grid-template-columns: minmax(300px, 680px);
  }
  .cms-entry-card {
    height: 240px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid #c9ced6;
    border-radius: 16px;
    background: var(--cms-panel);
    color: var(--cms-text);
    padding: 0;
    text-align: left;
    cursor: pointer;
    box-shadow: 0 8px 20px #1018280a;
  }
  .cms-entry-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 25px #10182818;
  }
  .cms-card-title {
    min-height: 72px;
    box-sizing: border-box;
    padding: 18px 20px;
    font-size: 17px;
    background: var(--cms-panel);
  }
  .cms-entry-card img,
  .cms-card-placeholder {
    width: 100%;
    height: 168px;
    object-fit: cover;
    background: linear-gradient(135deg, #dce5ea, #f4f5f7);
  }
  .cms-card-meta {
    display: none;
  }
  .cms-cards.list-view .cms-entry-card {
    height: auto;
    min-height: 76px;
  }
  .cms-cards.list-view .cms-entry-card img,
  .cms-cards.list-view .cms-card-placeholder {
    display: none;
  }
  .cms-group-title {
    grid-column: 1/-1;
    margin: 12px 0 0;
    font-size: 18px;
    color: var(--cms-muted);
  }
  #editor,
  #history {
    background: var(--cms-panel);
    color: var(--cms-text);
    border: 1px solid var(--cms-border);
    border-radius: 18px;
    padding: 22px;
    box-shadow: 0 12px 30px #10182812;
  }
  #editor input,
  #editor textarea,
  #editor select {
    background: var(--cms-panel);
    color: var(--cms-text);
    border-color: var(--cms-border);
  }
  #editor-title {
    color: var(--cms-blue) !important;
  }
  #save-draft-button {
    border-color: var(--cms-blue) !important;
    color: var(--cms-blue) !important;
    background: transparent !important;
    cursor: pointer;
  }
  #save-draft-button:hover {
    background: color-mix(in srgb, var(--cms-blue) 12%, transparent) !important;
  }
  #publish-button {
    border-color: var(--cms-blue) !important;
    background: var(--cms-blue) !important;
    color: #fff !important;
    cursor: pointer;
  }
  #publish-button:hover {
    filter: brightness(1.08);
  }
  #editor aside > div > span {
    background: color-mix(in srgb, var(--cms-blue) 14%, var(--cms-panel)) !important;
    color: var(--cms-blue) !important;
  }
  #live-preview {
    color: #333;
  }
  .cms-content-block-editor {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }
  .cms-content-block-editor.has-tools {
    grid-template-columns: 128px minmax(0, 1fr);
  }
  .cms-block-tools {
    display: flex;
    flex-direction: column;
    gap: 7px;
    align-self: start;
    border: 1px solid var(--cms-border);
    border-radius: 12px;
    background: color-mix(in srgb, var(--cms-blue) 4%, var(--cms-panel));
    padding: 10px;
  }
  .cms-block-tools strong,
  .cms-block-tools p {
    display: block;
  }
  .cms-block-tools p {
    margin: 3px 0 7px;
    color: var(--cms-muted);
    font-size: 10px;
    line-height: 1.35;
  }
  .cms-block-tools button {
    display: flex;
    align-items: center;
    gap: 7px;
    width: 100%;
    border: 1px solid var(--cms-border);
    border-radius: 8px;
    background: var(--cms-panel);
    color: var(--cms-text);
    padding: 8px;
    text-align: left;
    font: inherit;
    font-size: 11px;
    cursor: pointer;
  }
  .cms-block-tools button:hover,
  .cms-block-tools button:focus-visible {
    border-color: var(--cms-blue);
    color: var(--cms-blue);
  }
  .cms-block-tools button span {
    color: var(--cms-blue);
    font-size: 15px;
  }
  .cms-markdown-editor {
    min-width: 0;
  }
  .cms-editor-help {
    margin: 6px 0 0;
    color: var(--cms-muted);
    font-size: 11px;
  }
  .cms-markdown-preview {
    margin-top: 24px;
    color: #344054;
    font-size: 15px;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  .cms-markdown-preview > :first-child {
    margin-top: 0;
  }
  .cms-markdown-preview > :last-child {
    margin-bottom: 0;
  }
  .cms-markdown-preview h1,
  .cms-markdown-preview h2,
  .cms-markdown-preview h3,
  .cms-markdown-preview h4,
  .cms-markdown-preview h5,
  .cms-markdown-preview h6 {
    margin: 1.35em 0 0.55em;
    color: #182230;
    font-weight: 750;
    line-height: 1.25;
  }
  .cms-markdown-preview h1 {
    font-size: 2em;
  }
  .cms-markdown-preview h2 {
    border-bottom: 1px solid #e4e7ec;
    padding-bottom: 0.3em;
    font-size: 1.6em;
  }
  .cms-markdown-preview h3 {
    font-size: 1.35em;
  }
  .cms-markdown-preview h4 {
    font-size: 1.15em;
  }
  .cms-markdown-preview h5,
  .cms-markdown-preview h6 {
    font-size: 1em;
  }
  .cms-markdown-preview p,
  .cms-markdown-preview ul,
  .cms-markdown-preview ol,
  .cms-markdown-preview blockquote,
  .cms-markdown-preview pre,
  .cms-markdown-preview table,
  .cms-markdown-preview hr {
    margin: 0 0 1em;
  }
  .cms-markdown-preview ul,
  .cms-markdown-preview ol {
    padding-left: 1.6em;
  }
  .cms-markdown-preview ul {
    list-style: disc;
  }
  .cms-markdown-preview ol {
    list-style: decimal;
  }
  .cms-markdown-preview li + li {
    margin-top: 0.25em;
  }
  .cms-markdown-preview li > ul,
  .cms-markdown-preview li > ol {
    margin: 0.3em 0 0;
  }
  .cms-markdown-preview blockquote {
    border-left: 4px solid var(--cms-blue);
    background: #f8fafc;
    color: #475467;
    padding: 12px 16px;
  }
  .cms-markdown-preview blockquote > :last-child {
    margin-bottom: 0;
  }
  .cms-markdown-preview code {
    border-radius: 5px;
    background: #eef2f6;
    color: #9f1239;
    padding: 0.12em 0.35em;
