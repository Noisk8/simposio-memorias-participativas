---
import Layout from '../../layouts/Layout.astro';

const colecciones = [
  {
    name: 'proyectos',
    label: 'Proyectos del Museo de Memorias Vivas',
    path: '/admin/#/collections/proyectos',
  },
];
---

<Layout title="Gestionar colecciones - Admin">
  <section class="py-16 bg-white min-h-[60vh]">
    <div class="max-w-3xl mx-auto px-4">
      <h1 class="text-3xl font-bold mb-6 text-ugr-green-dark font-[family-name:var(--font-heading)]">
        Gestionar colecciones
      </h1>
      <p class="text-ugr-text-light mb-8">
        Desde aquí puedes acceder a las colecciones existentes y crear nuevas. Solo los usuarios con rol <strong>admin</strong> pueden crear colecciones.
      </p>

      <div id="not-allowed" class="hidden bg-red-50 text-red-700 p-4 rounded-lg mb-6">
        No tienes permiso. Inicia sesión con una cuenta de administrador.
      </div>

      <div id="loading" class="text-ugr-text-light mb-6">
        Verificando sesión...
      </div>

      <div id="admin-panel" class="hidden space-y-12">
        <div class="flex justify-end">
          <a href="/admin/gestion-usuarios" class="text-sm text-ugr-green hover:underline font-medium">
            Gestionar usuarios y roles →
          </a>
        </div>
        <section>
          <h2 class="text-xl font-semibold mb-4 text-ugr-text">Colecciones activas</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {colecciones.map((col) => (
              <a
                href={col.path}
                class="block p-5 border border-gray-200 rounded-lg hover:border-ugr-green hover:shadow-md transition-all"
              >
                <h3 class="font-semibold text-ugr-green mb-1">{col.label}</h3>
                <p class="text-sm text-ugr-text-light">Abrir en el CMS</p>
              </a>
            ))}
          </div>
        </section>

        <section id="nueva" class="border-t border-gray-200 pt-8">
          <h2 class="text-xl font-semibold mb-4 text-ugr-text">Crear nueva colección</h2>
          <form id="coleccion-form" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-semibold text-ugr-text mb-1" for="name">Nombre interno</label>
                <input type="text" id="name" name="name" required placeholder="ponentes" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green" />
                <p class="text-xs text-ugr-text-light mt-1">Solo letras, números y guiones. Ejemplo: <code>ponentes</code>.</p>
              </div>
              <div>
                <label class="block text-sm font-semibold text-ugr-text mb-1" for="label">Etiqueta visible</label>
                <input type="text" id="label" name="label" required placeholder="Ponentes del simposio" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green" />
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-semibold text-ugr-text mb-1" for="folder">Carpeta</label>
                <input type="text" id="folder" name="folder" required placeholder="src/content/ponentes" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green" />
              </div>
              <div>
                <label class="block text-sm font-semibold text-ugr-text mb-1" for="slug">Slug</label>
                <input type="text" id="slug" name="slug" required value="{{slug}}" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green" />
              </div>
            </div>

            <div>
              <label class="block text-sm font-semibold text-ugr-text mb-1" for="fields">Campos</label>
              <textarea id="fields" name="fields" rows="6" class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green font-mono text-sm">{`fields:
  - { label: "Título", name: "title", widget: "string" }
  - { label: "Imagen", name: "image", widget: "image", required: false }
  - { label: "Descripción", name: "description", widget: "text", required: false }
  - { label: "Contenido", name: "body", widget: "markdown", required: false }`}</textarea>
              <p class="text-xs text-ugr-text-light mt-1">Define los campos en formato YAML. Puedes ajustarlos después en <code>public/admin/config.yml</code>.</p>
            </div>

            <div class="flex items-center gap-4">
              <button type="submit" class="btn-green">
                Crear colección
              </button>
              <span id="status" class="text-sm font-medium"></span>
            </div>
          </form>
        </section>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  // @ts-nocheck
  const notAllowed = document.getElementById('not-allowed');
  const loading = document.getElementById('loading');
  const adminPanel = document.getElementById('admin-panel');
  const form = document.getElementById('coleccion-form');
  const status = document.getElementById('status');

  function waitForIdentity(callback) {
    if (window.netlifyIdentity) {
      callback(window.netlifyIdentity);
      return;
    }
    var attempts = 0;
    var interval = setInterval(function () {
      attempts++;
      if (window.netlifyIdentity) {
        clearInterval(interval);
        callback(window.netlifyIdentity);
      } else if (attempts > 60) {
        clearInterval(interval);
        loading.textContent = 'No se pudo cargar la autenticación.';
      }
    }, 100);
  }

  function isAdmin(user) {
    if (!user) return false;
    var metadata = user.app_metadata || user.user_metadata || {};
    var roles = metadata.roles || user.roles || [];
    return roles.indexOf('admin') !== -1;
  }

  function getUserName(user) {
    var metadata = user.user_metadata || user.app_metadata || {};
    return metadata.full_name || metadata.name || user.email;
  }

  waitForIdentity(function (identity) {
    function checkUser(user) {
      if (!user) {
        loading.classList.add('hidden');
        adminPanel.classList.add('hidden');
        notAllowed.classList.remove('hidden');
        notAllowed.textContent = 'Debes iniciar sesión para acceder.';
        return;
      }

      loading.classList.add('hidden');
      adminPanel.classList.remove('hidden');

      // Si el rol admin no está en el token, mostrar aviso sin bloquear:
      // la Netlify Function valida el permiso real (rol o ADMIN_EMAILS).
      if (!isAdmin(user)) {
        notAllowed.classList.remove('hidden');
        notAllowed.textContent = 'Hola ' + getUserName(user) + '. Tu token no incluye el rol admin; si eres administrador (ADMIN_EMAILS), las acciones funcionarán igualmente.';
      } else {
        notAllowed.classList.add('hidden');
      }
    }

    // Esperar a que Netlify Identity termine de inicializar la sesión.
    identity.on('init', checkUser);
    identity.on('login', checkUser);
    identity.on('logout', function () {
      checkUser(null);
    });
  });

  form?.addEventListener('submit', async function (e) {
    e.preventDefault();
    status.textContent = 'Creando...';
    status.className = 'text-sm font-medium text-ugr-text-light';

    var identity = window.netlifyIdentity;
    var user = identity?.currentUser?.();
    if (!user) {
      status.textContent = 'Debes iniciar sesión.';
      status.className = 'text-sm font-medium text-red-600';
      return;
    }

    var token = user.token?.access_token;
    if (!token) {
      status.textContent = 'No se encontró el token de sesión.';
      status.className = 'text-sm font-medium text-red-600';
      return;
    }

    var data = {
      name: document.getElementById('name').value.trim(),
      label: document.getElementById('label').value.trim(),
      folder: document.getElementById('folder').value.trim(),
      slug: document.getElementById('slug').value.trim(),
      fields: document.getElementById('fields').value,
    };

    try {
      var response = await fetch('/.netlify/functions/create-coleccion', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': 'Bearer ' + token,
        },
        body: JSON.stringify(data),
      });

      var result = await response.json();

      if (response.ok) {
        status.textContent = 'Colección creada. Redesplegando...';
        status.className = 'text-sm font-medium text-green-600';
        form.reset();
      } else {
        status.textContent = result.error || 'Error al crear la colección.';
        status.className = 'text-sm font-medium text-red-600';
      }
    } catch (err) {
      status.textContent = 'Error de red: ' + err.message;
      status.className = 'text-sm font-medium text-red-600';
    }
  });
</script>
