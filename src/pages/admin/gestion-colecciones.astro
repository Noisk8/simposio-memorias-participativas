---
import AdminLayout from '../../layouts/AdminLayout.astro';
import SupabaseAuth from '../../components/SupabaseAuth.astro';
---

<AdminLayout title="Gestionar colecciones - Admin">
  <section class="py-16 bg-white min-h-[60vh]">
    <div class="max-w-3xl mx-auto px-4">
      <h1
        class="text-3xl font-bold mb-6 text-ugr-green-dark font-[family-name:var(--font-heading)]"
      >
        Gestionar colecciones
      </h1>
      <p class="text-ugr-text-light mb-8">
        Desde aquí puedes crear la estructura de una colección nueva. La función exige el permiso <strong
          >settings.manage</strong
        >.
      </p>

      <SupabaseAuth redirectUnauthenticated />

      <div id="not-allowed" class="hidden bg-red-50 text-red-700 p-4 rounded-lg mb-6">
        No tienes permiso. Inicia sesión con una cuenta de administrador.
      </div>

      <div id="loading" class="text-ugr-text-light mb-6">Verificando sesión...</div>

      <div id="admin-panel" class="hidden space-y-12">
        <div class="flex justify-end">
          <a
            href="/admin/gestion-usuarios"
            class="text-sm text-ugr-green hover:underline font-medium"
          >
            Gestionar usuarios y roles →
          </a>
        </div>
        <div class="rounded-lg border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
          La edición general de Entradas, Páginas, Taxonomías y Simposios todavía debe migrarse al
          panel propio. El antiguo editor Decap fue desactivado para eliminar el segundo sistema de
          login.
        </div>

        <section id="nueva" class="border-t border-gray-200 pt-8">
          <h2 class="text-xl font-semibold mb-4 text-ugr-text">Crear nueva colección</h2>
          <form id="coleccion-form" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <label class="block text-sm font-semibold text-ugr-text mb-1" for="name"
                  >Nombre interno</label
                >
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="ponentes"
                  class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green"
                />
                <p class="text-xs text-ugr-text-light mt-1">
                  Solo minúsculas, números y guion bajo. Ejemplo: <code>ponentes</code>.
                </p>
              </div>
              <div>
                <label class="block text-sm font-semibold text-ugr-text mb-1" for="label"
                  >Etiqueta visible</label
                >
                <input
                  type="text"
                  id="label"
                  name="label"
                  required
                  placeholder="Ponentes del simposio"
                  class="w-full border border-gray-300 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-ugr-green"
                />
              </div>
            </div>

            <div>
              <label class="block text-sm font-semibold text-ugr-text mb-1" for="folder"
                >Carpeta</label
              >
              <div
                class="flex items-center border border-gray-300 rounded-lg overflow-hidden focus-within:ring-2 focus-within:ring-ugr-green"
              >
                <span
                  class="px-3 py-2 bg-gray-100 text-ugr-text-light text-sm font-mono border-r border-gray-300 select-none whitespace-nowrap"
                >
                  src/content/
                </span>
                <input
                  type="text"
                  id="folder"
                  name="folder"
                  required
                  placeholder="ponentes"
                  class="flex-1 px-3 py-2 focus:outline-none text-sm"
                />
              </div>
              <p class="text-xs text-ugr-text-light mt-1">
                Solo el nombre de la carpeta. Ejemplo: <code>ponentes</code>.
              </p>
            </div>

            <div class="flex items-center gap-4">
              <button type="submit" class="btn-green"> Crear colección </button>
              <span id="status" class="text-sm font-medium"></span>
            </div>
          </form>
        </section>
      </div>
    </div>
  </section>
</AdminLayout>

<script is:inline>
  // @ts-nocheck
  const notAllowed = document.getElementById('not-allowed');
  const loading = document.getElementById('loading');
  const adminPanel = document.getElementById('admin-panel');
  const form = document.getElementById('coleccion-form');
  const status = document.getElementById('status');

  function waitForAuth(callback) {
    if (window.supabaseAuth) {
      callback(window.supabaseAuth);
      return;
    }
    var attempts = 0;
    var interval = setInterval(function () {
      attempts++;
      if (window.supabaseAuth) {
        clearInterval(interval);
        callback(window.supabaseAuth);
      } else if (attempts > 60) {
        clearInterval(interval);
        loading.textContent = 'No se pudo cargar la autenticación.';
      }
    }, 100);
  }

  async function getToken() {
    var auth = window.supabaseAuth;
    return auth ? await auth.getToken() : null;
  }

  waitForAuth(function (auth) {
    function refresh() {
      auth.getUser().then(function (user) {
        loading.classList.add('hidden');
        if (!user) {
          adminPanel.classList.add('hidden');
          notAllowed.classList.add('hidden');
          return;
        }

        // El acceso real lo valida la Netlify Function; aquí solo mostramos el panel.
        adminPanel.classList.remove('hidden');
        notAllowed.classList.add('hidden');
      });
    }

    auth.ready.then(refresh);
    window.addEventListener('supabase-auth', refresh);
  });

  form?.addEventListener('submit', async function (e) {
    e.preventDefault();
    status.textContent = 'Creando...';
    status.className = 'text-sm font-medium text-ugr-text-light';

    var token = await getToken();
    if (!token) {
      status.textContent = 'No se encontró el token de sesión.';
      status.className = 'text-sm font-medium text-red-600';
      return;
    }

    var folderName = document
      .getElementById('folder')
      .value.trim()
      .replace(/^src\/content\/?/, '');
    var data = {
      name: document.getElementById('name').value.trim(),
      label: document.getElementById('label').value.trim(),
      folder: 'src/content/' + folderName,
      slug: '{{slug}}',
    };

    try {
      var response = await fetch('/.netlify/functions/create-coleccion', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: 'Bearer ' + token,
        },
        body: JSON.stringify(data),
      });

      var result = await response.json();

      if (response.ok) {
        status.textContent = 'Colección creada. Redesplegando...';
        status.className = 'text-sm font-medium text-green-600';
        form.reset();
      } else {
        status.textContent =
          (result.error && result.error.message) || 'Error al crear la colección.';
        status.className = 'text-sm font-medium text-red-600';
      }
    } catch (err) {
      status.textContent = 'Error de red: ' + err.message;
      status.className = 'text-sm font-medium text-red-600';
    }
  });
</script>
