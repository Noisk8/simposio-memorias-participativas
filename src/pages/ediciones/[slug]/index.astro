---
import Layout from '../../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { getSimposioBySlug } from '../../../lib/simposios';
import { NETWORK_INSTAGRAM } from '../../../consts';
import { filterPublished } from '../../../lib/taxonomies';

export const getStaticPaths: GetStaticPaths = async () => {
  const simposios = await getCollection('simposios');
  return simposios.map((s) => ({ params: { slug: s.data.slug } }));
};

const { slug } = Astro.params;
const simposio = await getSimposioBySlug(slug || '2026');
if (!simposio) {
  throw new Error(`No se encontró el simposio con slug: ${slug}`);
}

const data = simposio.data;
const paginas = filterPublished(await getCollection('paginas')).filter(
  ({ data }) => data.simposio === (slug || '2026')
);
const paginaInfo = paginas.find((p) => p.data.template === 'el-simposio');
const InfoContent = paginaInfo ? (await render(paginaInfo)).Content : null;
---

<Layout
  title={`${data.title} · Red Internacional de Memorias Participativas`}
  description={data.theme}
>
  <!-- Hero Section -->
  <section class="relative h-[60vh] min-h-[400px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src={data.image || '/images/hero-bg.jpg'}
        alt={data.title}
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70"></div>
    </div>
    <div class="relative z-10 text-center px-4">
      <p class="text-sm md:text-base text-white/80 uppercase tracking-widest mb-3">
        Red Internacional de Memorias Participativas
      </p>
      <h1
        class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4 font-[family-name:var(--font-heading)] drop-shadow-lg"
      >
        {data.title.toUpperCase()}
      </h1>
      <p class="text-xl md:text-2xl text-white/90 max-w-3xl mx-auto drop-shadow-md">
        {data.place}
      </p>
      {data.theme && <p class="mt-4 text-lg text-white/80 max-w-2xl mx-auto">{data.theme}</p>}
    </div>
  </section>

  <!-- Cartel Oficial -->
  {
    data.poster && (
      <section class="py-16 bg-white">
        <div class="max-w-4xl mx-auto px-4 text-center">
          <h2 class="text-3xl font-bold mb-10 text-ugr-green-dark font-[family-name:var(--font-heading)]">
            Cartel Oficial
          </h2>
          <div class="card-shadow rounded-xl overflow-hidden inline-block">
            <img
              src={data.poster}
              alt={`Cartel Oficial del ${data.title}`}
              class="w-full max-w-2xl mx-auto hover:scale-[1.02] transition-transform duration-500"
            />
          </div>
        </div>
      </section>
    )
  }

  <!-- Información del simposio -->
  {
    InfoContent && (
      <section class="py-16 bg-ugr-cream">
        <div class="max-w-4xl mx-auto px-4">
          <h2 class="text-3xl font-bold mb-8 text-ugr-green-dark font-[family-name:var(--font-heading)] text-center">
            Acerca de esta edición
          </h2>
          <div class="prose prose-lg max-w-none text-ugr-text prose-headings:text-ugr-green-dark prose-a:text-ugr-green bg-white rounded-xl p-8 card-shadow">
            <InfoContent />
          </div>
        </div>
      </section>
    )
  }

  <!-- Enlaces principales -->
  <section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4">
      <h2
        class="text-3xl font-bold mb-10 text-ugr-green-dark font-[family-name:var(--font-heading)] text-center"
      >
        Explora el simposio
      </h2>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <a
          href={`/ediciones/${data.slug}/el-simposio`}
          class="card-shadow bg-ugr-cream rounded-xl p-6 text-center hover:border-ugr-green border border-transparent transition-all"
        >
          <h3
            class="text-xl font-bold text-ugr-green-dark mb-2 font-[family-name:var(--font-heading)]"
          >
            El Simposio
          </h3>
          <p class="text-sm text-ugr-text-light">Propósito, objetivos y dinámica</p>
        </a>
        <a
          href={`/ediciones/${data.slug}/programa`}
          class="card-shadow bg-ugr-cream rounded-xl p-6 text-center hover:border-ugr-green border border-transparent transition-all"
        >
          <h3
            class="text-xl font-bold text-ugr-green-dark mb-2 font-[family-name:var(--font-heading)]"
          >
            Programa
          </h3>
          <p class="text-sm text-ugr-text-light">Sesiones, talleres y actividades</p>
        </a>
        <a
          href={`/ediciones/${data.slug}/organizacion`}
          class="card-shadow bg-ugr-cream rounded-xl p-6 text-center hover:border-ugr-green border border-transparent transition-all"
        >
          <h3
            class="text-xl font-bold text-ugr-green-dark mb-2 font-[family-name:var(--font-heading)]"
          >
            Organización
          </h3>
          <p class="text-sm text-ugr-text-light">Equipo e instituciones</p>
        </a>
        <a
          href="/museo-memorias"
          class="card-shadow bg-ugr-cream rounded-xl p-6 text-center hover:border-ugr-green border border-transparent transition-all"
        >
          <h3
            class="text-xl font-bold text-ugr-green-dark mb-2 font-[family-name:var(--font-heading)]"
          >
            Museo de Memorias Vivas
          </h3>
          <p class="text-sm text-ugr-text-light">Memorias y exposiciones</p>
        </a>
        <a
          href={`/ediciones/${data.slug}/entradas`}
          class="card-shadow bg-ugr-cream rounded-xl p-6 text-center hover:border-ugr-green border border-transparent transition-all"
        >
          <h3
            class="text-xl font-bold text-ugr-green-dark mb-2 font-[family-name:var(--font-heading)]"
          >
            Entradas
          </h3>
          <p class="text-sm text-ugr-text-light">Noticias y novedades</p>
        </a>
        <a
          href={`/ediciones/${data.slug}/contacto`}
          class="card-shadow bg-ugr-cream rounded-xl p-6 text-center hover:border-ugr-green border border-transparent transition-all"
        >
          <h3
            class="text-xl font-bold text-ugr-green-dark mb-2 font-[family-name:var(--font-heading)]"
          >
            Contacto
          </h3>
          <p class="text-sm text-ugr-text-light">Email y redes sociales</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Llamada a la acción -->
  <section class="py-16 bg-ugr-green text-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2 class="text-3xl font-bold mb-6 font-[family-name:var(--font-heading)]">
        ¿Querés conocer más de la Red?
      </h2>
      <p class="text-lg text-white/90 mb-8">
        Este simposio es parte de la Red Internacional de Memorias Participativas, un espacio de
        encuentro, investigación y acción sobre memorias en territorio.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a
          href="/acerca-de"
          class="bg-white text-ugr-green px-6 py-3 rounded-lg font-semibold hover:bg-ugr-cream transition-colors"
        >
          Acerca de la Red
        </a>
        <a
          href="/simposios"
          class="border-2 border-white text-white px-6 py-3 rounded-lg font-semibold hover:bg-white hover:text-ugr-green transition-colors"
        >
          Ver ediciones
        </a>
      </div>
    </div>
  </section>

  <!-- Instagram -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 text-center">
      <h2
        class="text-3xl font-bold mb-8 text-ugr-green-dark font-[family-name:var(--font-heading)]"
      >
        Síguenos en Instagram
      </h2>
      <div class="card-shadow bg-ugr-cream rounded-xl p-8 max-w-md mx-auto">
        <p class="text-ugr-text-light mb-4 font-semibold">@memoriasparticipativas</p>
        <a
          href={NETWORK_INSTAGRAM}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-green inline-flex items-center gap-2"
        >
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
            <path
              d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"
            ></path>
          </svg>
          Seguir en Instagram
        </a>
      </div>
    </div>
  </section>
</Layout>
