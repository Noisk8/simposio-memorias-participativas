---
import Layout from '../../../layouts/Layout.astro';
import PageTemplate from '../../../components/PageTemplate.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { getSimposioBySlug } from '../../../lib/simposios';
import { filterPublished, sortByDateDesc } from '../../../lib/taxonomies';
import { entryBelongsToPage } from '../../../../shared/content/page-relations';

interface Props {
  entry: CollectionEntry<'paginas'>;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const paginas = filterPublished(await getCollection('paginas'));
  return paginas.map((entry) => ({
    params: { slug: entry.data.simposio, pagina: entry.data.slug || entry.data.template },
    props: { entry },
  }));
};

const { entry } = Astro.props;
const { slug } = Astro.params;
const { Content } = await render(entry);
const data = entry.data;
const simposio = await getSimposioBySlug(slug || data.simposio);
const simposioTitle = simposio?.data.title || `Edición ${data.simposio}`;
const entries = filterPublished(await getCollection('entradas')).filter((item) =>
  entryBelongsToPage(item, entry)
);
sortByDateDesc(entries);

const pageTitle = `${data.title} - ${simposioTitle}`;
const heroImage = data.image || simposio?.data.image || '/images/hero-bg.jpg';
---

<Layout title={pageTitle} description={data.description} image={heroImage}>
  <PageTemplate
    data={data}
    simposio={simposio}
    simposioTitle={simposioTitle}
    entries={entries}
    crumbs={[{ label: simposioTitle, href: `/ediciones/${slug}/` }]}
  >
    <Content />
  </PageTemplate>
</Layout>
