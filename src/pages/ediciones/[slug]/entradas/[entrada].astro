---
import Layout from '../../../../layouts/Layout.astro';
import TermPills from '../../../../components/TermPills.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import {
  getCategorias,
  getEtiquetas,
  slugTitleMap,
  formatDate,
  filterPublished,
} from '../../../../lib/taxonomies';
import { getSimposioBySlug } from '../../../../lib/simposios';

type Props = {
  entry: CollectionEntry<'entradas'>;
};

export const getStaticPaths: GetStaticPaths = async () => {
  const entradas = filterPublished(await getCollection('entradas'));
  return entradas.map((entry) => ({
    params: { slug: entry.data.simposio, entrada: entry.id },
    props: { entry },
  }));
};

const { entry } = Astro.props;
const { slug } = Astro.params;
const { Content } = await render(entry);
const entrada = entry.data;

const catTitles = slugTitleMap(await getCategorias());
const tagTitles = slugTitleMap(await getEtiquetas());
const simposio = await getSimposioBySlug(slug || entrada.simposio || '2026');
const simposioTitle = simposio?.data.title || `Edición ${slug}`;
---

<Layout title={`${entrada.title} - ${simposioTitle}`}>
  <section class="bg-ugr-green py-14 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <nav class="text-white/70 text-sm mb-4">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <span class="mx-2">/</span>
        <a href={`/ediciones/${slug}/`} class="hover:text-white transition-colors"
          >{simposioTitle}</a
        >
        <span class="mx-2">/</span>
        <a href={`/ediciones/${slug}/entradas/`} class="hover:text-white transition-colors"
          >Entradas</a
        >
        <span class="mx-2">/</span>
        <span class="text-white">{entrada.title}</span>
      </nav>
      <h1
        class="text-3xl md:text-4xl font-bold text-white font-[family-name:var(--font-heading)] drop-shadow-lg max-w-4xl mx-auto"
      >
        {entrada.title}
      </h1>
      {
        (entrada.date || entrada.author) && (
          <p class="mt-3 text-white/80 text-sm">
            {formatDate(entrada.date)}
            {entrada.date && entrada.author ? ' · ' : ''}
            {entrada.author}
          </p>
        )
      }
    </div>
  </section>

  <section class="py-12 bg-white">
    <div class="max-w-3xl mx-auto px-4">
      {
        entrada.image && (
          <div class="mb-8">
            <img src={entrada.image} alt={entrada.title} class="w-full rounded-xl shadow-lg" />
          </div>
        )
      }

      <div class="mb-6">
        <TermPills
          categories={entrada.categories}
          tags={entrada.tags}
          catTitles={catTitles}
          tagTitles={tagTitles}
        />
      </div>

      {
        entrada.description && (
          <p class="text-lg text-ugr-text leading-relaxed mb-8 font-medium border-l-4 border-ugr-green pl-4">
            {entrada.description}
          </p>
        )
      }

      <div
        class="prose prose-lg max-w-none text-ugr-text prose-headings:text-ugr-green-dark prose-a:text-ugr-green"
      >
        <Content />
      </div>

      <div class="mt-12 text-center">
        <a href={`/ediciones/${slug}/entradas/`} class="btn-green inline-block px-6 py-3">
          ← Volver a Entradas
        </a>
      </div>
    </div>
  </section>
</Layout>
