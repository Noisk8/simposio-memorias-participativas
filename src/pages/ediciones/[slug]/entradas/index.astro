---
import Layout from '../../../../layouts/Layout.astro';
import TermPills from '../../../../components/TermPills.astro';
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { getCategorias, getEtiquetas, termSlugMap, formatDate, sortByDateDesc } from '../../../../lib/taxonomies';
import { getSimposioBySlug } from '../../../../lib/simposios';

export const getStaticPaths: GetStaticPaths = async () => {
  const entradas = await getCollection('entradas', ({ data }) => !data.draft);
  const slugs = new Set(entradas.map((e) => e.data.simposio));
  return Array.from(slugs).map((slug) => ({ params: { slug } }));
};

const { slug } = Astro.params;
const simposio = await getSimposioBySlug(slug || '2026');
const simposioTitle = simposio?.data.title || `Edición ${slug}`;

const entradas = await getCollection('entradas', ({ data }) => !data.draft && data.simposio === slug);
sortByDateDesc(entradas);

const catSlugs = termSlugMap(await getCategorias());
const tagSlugs = termSlugMap(await getEtiquetas());
---

<Layout title={`Entradas - ${simposioTitle}`}>
  <!-- Hero -->
  <section class="bg-ugr-green py-14 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <nav class="text-white/70 text-sm mb-4">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <span class="mx-2">/</span>
        <a href={`/ediciones/${slug}/`} class="hover:text-white transition-colors">{simposioTitle}</a>
        <span class="mx-2">/</span>
        <span class="text-white">Entradas</span>
      </nav>
      <h1 class="text-4xl md:text-5xl font-bold text-white font-[family-name:var(--font-heading)] drop-shadow-lg">
        Entradas
      </h1>
    </div>
  </section>

  <!-- Listado -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4">
      {entradas.length === 0 && (
        <p class="text-center text-ugr-text-light py-16">No hay entradas publicadas todavía.</p>
      )}
      <div class="grid gap-8 md:grid-cols-2">
        {entradas.map((entry) => (
          <article class="bg-white rounded-xl overflow-hidden border border-gray-100 shadow-sm hover:shadow-md hover:border-ugr-green/30 transition-all duration-300 group">
            {entry.data.image && (
              <a href={`/entradas/${entry.id}`} class="block relative h-48 overflow-hidden">
                <img src={entry.data.image} alt={entry.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              </a>
            )}
            <div class="p-5">
              {entry.data.date && (
                <p class="text-xs text-ugr-green-light font-semibold uppercase tracking-wide mb-1">{formatDate(entry.data.date)}</p>
              )}
              <a href={`/entradas/${entry.id}`}>
                <h2 class="text-lg font-bold text-ugr-green-dark mb-2 font-[family-name:var(--font-heading)] line-clamp-2 group-hover:text-ugr-green transition-colors">{entry.data.title}</h2>
              </a>
              <div class="mb-3">
                <TermPills categories={entry.data.categories} tags={entry.data.tags} catSlugs={catSlugs} tagSlugs={tagSlugs} size="sm" />
              </div>
              {entry.data.description && (
                <p class="text-sm text-ugr-text-light line-clamp-3">{entry.data.description}</p>
              )}
              <a href={`/entradas/${entry.id}`} class="inline-block mt-4 text-xs font-semibold text-ugr-green uppercase tracking-wide hover:underline">Leer más →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>
