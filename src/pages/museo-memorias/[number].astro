---
import Layout from '../../layouts/Layout.astro';
import TermPills from '../../components/TermPills.astro';
import GiscusComments from '../../components/GiscusComments.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { getCategorias, getEtiquetas, slugTitleMap, filterPublished } from '../../lib/taxonomies';
import { getSimposioBySlug } from '../../lib/simposios';
import { resolvePublicImageUrl } from '../../lib/public-image';

type Props = {
  entry: CollectionEntry<'memorias'>;
};

export const getStaticPaths: GetStaticPaths = async () => {
  const allMemorias = await getCollection('memorias');
  const memorias = filterPublished(allMemorias);
  return memorias.map((entry) => ({
    params: { number: entry.data.number.toString() },
    props: { entry },
  }));
};

const { entry } = Astro.props;
const { Content } = await render(entry);
const memoria = entry.data;

const allMemoriasNav = await getCollection('memorias');
const todos = filterPublished(allMemoriasNav);
const ordenados = todos.sort((a, b) => b.data.number - a.data.number);
const idx = ordenados.findIndex((e) => e.data.number === memoria.number);
const prevMemoria = idx < ordenados.length - 1 ? ordenados[idx + 1] : null;
const nextMemoria = idx > 0 ? ordenados[idx - 1] : null;

const catTitles = slugTitleMap(await getCategorias());
const tagTitles = slugTitleMap(await getEtiquetas());
const simposio = await getSimposioBySlug(memoria.simposio || '2026');
const simposioTitle = simposio?.data.title || memoria.simposio;

const allPublished = filterPublished(await getCollection('memorias'));
const related = allPublished
  .filter(
    (p) =>
      p.data.number !== memoria.number &&
      ((p.data.categories || []).some((c) => (memoria.categories || []).includes(c)) ||
        (p.data.tags || []).some((t) => (memoria.tags || []).includes(t)))
  )
  .slice(0, 3);
---

<Layout
  title={`${memoria.title} - Museo de Memorias Vivas`}
  description={memoria.description}
  image={memoria.image}
  type="article"
  canonical={`/museo-memorias/${memoria.number}/`}
  publishDate={memoria.publish_date}
  author={memoria.author || memoria.collective}
  authorType={memoria.author ? 'Person' : 'Organization'}
  section={memoria.categories[0]}
  tags={memoria.tags}
  keywords={[...memoria.categories, ...memoria.tags]}
>
  <section class="relative h-[30vh] min-h-[250px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/hero-bg.jpg"
        alt="Museo de Memorias Vivas"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-black/60"></div>
    </div>
    <div class="relative z-10 text-center px-4">
      <nav class="text-white/70 text-sm mb-4">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <span class="mx-2">/</span>
        <a href="/museo-memorias/" class="hover:text-white transition-colors"
          >Museo de Memorias Vivas</a
        >
        <span class="mx-2">/</span>
        <span class="text-white">{memoria.number}. {memoria.title}</span>
      </nav>
      <h1
        class="text-3xl md:text-4xl font-bold text-white font-[family-name:var(--font-heading)] drop-shadow-lg max-w-4xl mx-auto"
      >
        {memoria.number}. {memoria.title}
      </h1>
      <p class="mt-3 text-white/80 text-sm">
        {simposioTitle}
      </p>
    </div>
  </section>

  <section class="py-12 bg-white">
    <div class="max-w-4xl mx-auto px-4">
      <div class="mb-8">
        <img
          src={resolvePublicImageUrl(memoria.image)}
          alt={memoria.title}
          class="w-full rounded-xl shadow-lg object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="flex flex-wrap gap-4 mb-8 text-sm">
        <div class="flex items-center gap-2 text-ugr-green">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span>{memoria.place}</span>
        </div>
        {
          memoria.author && (
            <div class="flex items-center gap-2 text-ugr-text-light">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"
                />
              </svg>
              <span>{memoria.author}</span>
            </div>
          )
        }
        {
          memoria.collective && (
            <div class="flex items-center gap-2 text-ugr-text-light">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"
                />
              </svg>
              <span>{memoria.collective}</span>
            </div>
          )
        }
      </div>

      <div class="mb-6">
        <TermPills
          categories={memoria.categories}
          tags={memoria.tags}
          catTitles={catTitles}
          tagTitles={tagTitles}
        />
      </div>

      {
        memoria.description && (
          <p class="text-lg text-ugr-text leading-relaxed mb-6 font-medium border-l-4 border-ugr-green pl-4">
            {memoria.description}
          </p>
        )
      }

      <div
        class="prose prose-lg max-w-none text-ugr-text prose-headings:text-ugr-green-dark prose-a:text-ugr-green"
      >
        <Content />
      </div>

      {
        related.length > 0 && (
          <div class="mt-12 pt-8 border-t border-gray-200">
            <h2 class="text-2xl font-bold text-ugr-green-dark mb-6 font-[family-name:var(--font-heading)]">
              Memorias relacionadas
            </h2>
            <div class="grid gap-6 md:grid-cols-3">
              {related.map((r) => (
                <a
                  href={`/museo-memorias/${r.data.number}`}
                  class="block bg-gray-50 rounded-xl p-4 hover:bg-ugr-green/5 transition-colors"
                >
                  <img
                    src={resolvePublicImageUrl(r.data.image)}
                    alt={r.data.title}
                    class="w-full h-32 object-cover rounded-lg mb-3"
                    loading="lazy"
                    decoding="async"
                  />
                  <h3 class="font-bold text-ugr-green-dark text-sm line-clamp-2">{r.data.title}</h3>
                  <p class="text-xs text-ugr-text-light mt-1">{r.data.place}</p>
                </a>
              ))}
            </div>
          </div>
        )
      }

      <div
        class="mt-12 pt-8 border-t border-gray-200 flex flex-col sm:flex-row gap-4 justify-between"
      >
        {
          prevMemoria && (
            <a
              href={`/museo-memorias/${prevMemoria.data.number}`}
              class="flex items-center gap-3 text-ugr-green hover:text-ugr-green-dark transition-colors group"
            >
              <span class="text-2xl">←</span>
              <div>
                <p class="text-xs text-ugr-text-light uppercase tracking-wide mb-1">
                  Memoria anterior
                </p>
                <p class="font-semibold line-clamp-1 group-hover:underline">
                  {prevMemoria.data.title}
                </p>
              </div>
            </a>
          )
        }
        {
          nextMemoria && (
            <a
              href={`/museo-memorias/${nextMemoria.data.number}`}
              class="flex items-center gap-3 text-ugr-green hover:text-ugr-green-dark transition-colors group sm:text-right sm:flex-row-reverse"
            >
              <span class="text-2xl">→</span>
              <div>
                <p class="text-xs text-ugr-text-light uppercase tracking-wide mb-1">
                  Memoria siguiente
                </p>
                <p class="font-semibold line-clamp-1 group-hover:underline">
                  {nextMemoria.data.title}
                </p>
              </div>
            </a>
          )
        }
      </div>

      <div class="mt-8 text-center">
        <a href="/museo-memorias/" class="btn-green inline-block px-6 py-3">
          ← Volver al Museo de Memorias Vivas
        </a>
      </div>

      <GiscusComments />
    </div>
  </section>
</Layout>
