---
import Layout from '../../layouts/Layout.astro';
import TermPills from '../../components/TermPills.astro';
import { getCollection } from 'astro:content';
import { getCategorias, getEtiquetas, slugTitleMap, filterPublished } from '../../lib/taxonomies';
import { getSimposios } from '../../lib/simposios';

const PAGE_SIZE = 10;

const catTitles = slugTitleMap(await getCategorias());
const tagTitles = slugTitleMap(await getEtiquetas());
const simposios = await getSimposios();

const allMemorias = await getCollection('memorias');
const todos = filterPublished(allMemorias);
const memorias = todos.sort((a, b) => b.data.number - a.data.number).slice(0, PAGE_SIZE);

const totalPages = Math.ceil(todos.length / PAGE_SIZE);
const simposioMap = new Map(simposios.map((s) => [s.data.slug, s.data.title]));
---

<Layout title="Museo de Memorias Vivas - Red Internacional de Memorias Participativas">
  <!-- Hero -->
  <section class="relative h-[40vh] min-h-[300px] flex items-center justify-center overflow-hidden">
    <div class="absolute inset-0">
      <img
        src="/images/hero-bg.jpg"
        alt="Museo de Memorias Vivas"
        class="w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="absolute inset-0 bg-black/60"></div>
    </div>
    <div class="relative z-10 text-center px-4">
      <nav class="text-white/70 text-sm mb-4">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <span class="mx-2">/</span>
        <span class="text-white">Museo de Memorias Vivas</span>
      </nav>
      <h1
        class="text-4xl md:text-5xl font-bold text-white font-[family-name:var(--font-heading)] drop-shadow-lg"
      >
        Museo de Memorias Vivas
      </h1>
      <p class="mt-3 text-white/80 text-sm max-w-2xl mx-auto">
        Archivo transversal de la Red Internacional de Memorias Participativas
      </p>
    </div>
  </section>

  <!-- Coordinación -->
  <section class="py-8 bg-ugr-cream border-b">
    <div class="max-w-5xl mx-auto px-4">
      <p class="text-ugr-text text-center">
        <strong class="text-ugr-green-dark">Coordinación de curaduría y museografía:</strong> Natalia
        Luc<br />
        <strong class="text-ugr-green-dark">Co-curaduría:</strong> Natalia Luc, Diana Castelblanco, Sorany
        Marín, Andrés Góngora y Johana Botero
      </p>
    </div>
  </section>

  <!-- Filtro por simposio -->
  <section class="py-8 bg-white border-b">
    <div class="max-w-6xl mx-auto px-4">
      <div class="flex flex-wrap items-center gap-3 justify-center">
        <span class="text-sm font-semibold text-ugr-text">Filtrar por simposio:</span>
        <button
          type="button"
          class="simposio-filter active px-4 py-2 rounded-full text-sm font-semibold bg-ugr-green text-white transition-colors"
          data-filter="all"
        >
          Todos
        </button>
        {
          simposios.map((s) => (
            <button
              type="button"
              class="simposio-filter px-4 py-2 rounded-full text-sm font-semibold bg-gray-100 text-ugr-green hover:bg-ugr-green/10 transition-colors"
              data-filter={s.data.slug}
            >
              {s.data.title}
            </button>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Grid de memorias -->
  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4">
      <div id="memorias-grid" class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {
          memorias.map((entry) => (
            <article
              class="memoria-card card-shadow bg-white rounded-xl overflow-hidden border border-gray-100 hover:border-ugr-green/30 transition-all duration-300 group"
              data-simposio={entry.data.simposio}
            >
              <a
                href={`/museo-memorias/${entry.data.number}`}
                class="block relative h-48 overflow-hidden"
              >
                <img
                  src={entry.data.image}
                  alt={entry.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute top-3 left-3">
                  <span class="bg-ugr-green text-white text-xs font-bold px-3 py-1 rounded-full">
                    {entry.data.number}
                  </span>
                </div>
                <div class="absolute top-3 right-3">
                  <span class="bg-white/90 text-ugr-green-dark text-xs font-bold px-3 py-1 rounded-full">
                    {simposioMap.get(entry.data.simposio) || entry.data.simposio}
                  </span>
                </div>
              </a>
              <div class="p-5">
                <a href={`/museo-memorias/${entry.data.number}`}>
                  <h3 class="text-lg font-bold text-ugr-green-dark mb-2 font-[family-name:var(--font-heading)] line-clamp-2">
                    {entry.data.title}
                  </h3>
                </a>
                <p class="text-xs text-ugr-green-light mb-2 font-semibold uppercase tracking-wide">
                  {entry.data.place}
                </p>
                <div class="mb-2">
                  <TermPills
                    categories={entry.data.categories}
                    tags={entry.data.tags}
                    catTitles={catTitles}
                    tagTitles={tagTitles}
                    size="sm"
                  />
                </div>
                <p class="text-sm text-ugr-text-light line-clamp-3">{entry.data.description}</p>
                <p class="text-xs text-ugr-text-light mt-3 italic">
                  {entry.data.author || entry.data.collective}
                </p>
              </div>
            </article>
          ))
        }
      </div>

      <p id="no-results" class="hidden text-center text-ugr-text-light py-16">
        No hay memorias para el filtro seleccionado.
      </p>

      <!-- Paginación -->
      <nav class="mt-12 flex justify-center items-center gap-2">
        <span
          class="w-10 h-10 flex items-center justify-center rounded-lg font-semibold bg-ugr-green text-white shadow-md"
          >1</span
        >
        {
          Array.from({ length: totalPages - 1 }, (_, i) => i + 2).map((p) => (
            <a
              href={`/museo-memorias/page/${p}`}
              class="w-10 h-10 flex items-center justify-center rounded-lg font-semibold bg-gray-100 text-ugr-green hover:bg-ugr-green/10 transition-all duration-300"
            >
              {p}
            </a>
          ))
        }
        {
          totalPages > 1 && (
            <a href="/museo-memorias/page/2" class="btn-green px-4 py-2 text-sm">
              Siguiente →
            </a>
          )
        }
      </nav>
    </div>
  </section>
</Layout>

<script is:inline>
  (function () {
    const buttons = document.querySelectorAll('.simposio-filter');
    const cards = document.querySelectorAll('.memoria-card');
    const noResults = document.getElementById('no-results');

    buttons.forEach((btn) => {
      btn.addEventListener('click', function () {
        const filter = this.dataset.filter;

        buttons.forEach((b) => {
          b.classList.remove('bg-ugr-green', 'text-white');
          b.classList.add('bg-gray-100', 'text-ugr-green');
        });
        this.classList.remove('bg-gray-100', 'text-ugr-green');
        this.classList.add('bg-ugr-green', 'text-white');

        let visible = 0;
        cards.forEach((card) => {
          const match = filter === 'all' || card.dataset.simposio === filter;
          card.style.display = match ? '' : 'none';
          if (match) visible++;
        });

        noResults.classList.toggle('hidden', visible > 0);
      });
    });
  })();
</script>
