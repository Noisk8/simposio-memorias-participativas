---
import Layout from '../../layouts/Layout.astro';
import TermPills from '../../components/TermPills.astro';
import GiscusComments from '../../components/GiscusComments.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { getCategorias, getEtiquetas, termSlugMap, formatDate, filterPublished } from '../../lib/taxonomies';
import { resolveSimposioSlug } from '../../lib/simposios';

type Props = {
  entry: CollectionEntry<'entradas'>;
};

export const getStaticPaths: GetStaticPaths = async () => {
  const defaultSlug = await resolveSimposioSlug();
  const allEntradas = await getCollection('entradas', ({ data }) => data.simposio === defaultSlug);
  const entradas = filterPublished(allEntradas);
  return entradas.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
};

const { entry } = Astro.props;
const { Content } = await render(entry);
const entrada = entry.data;

const catSlugs = termSlugMap(await getCategorias());
const tagSlugs = termSlugMap(await getEtiquetas());
---

<Layout title={`${entrada.title} - Entradas`}>
  <!-- Hero -->
  <section class="bg-ugr-green py-14 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <nav class="text-white/70 text-sm mb-4">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <span class="mx-2">/</span>
        <a href="/entradas/" class="hover:text-white transition-colors">Entradas</a>
        <span class="mx-2">/</span>
        <span class="text-white">{entrada.title}</span>
      </nav>
      <h1 class="text-3xl md:text-4xl font-bold text-white font-[family-name:var(--font-heading)] drop-shadow-lg max-w-4xl mx-auto">
        {entrada.title}
      </h1>
      {(entrada.date || entrada.author) && (
        <p class="mt-3 text-white/80 text-sm">
          {formatDate(entrada.date)}{entrada.date && entrada.author ? ' · ' : ''}{entrada.author}
        </p>
      )}
    </div>
  </section>

  <!-- Contenido -->
  <section class="py-12 bg-white">
    <div class="max-w-3xl mx-auto px-4">
      {entrada.image && (
        <div class="mb-8">
          <img
            src={entrada.image}
            alt={entrada.title}
            class="w-full rounded-xl shadow-lg"
          />
        </div>
      )}

      <div class="mb-6">
        <TermPills categories={entrada.categories} tags={entrada.tags} catSlugs={catSlugs} tagSlugs={tagSlugs} />
      </div>

      {entrada.description && (
        <p class="text-lg text-ugr-text leading-relaxed mb-8 font-medium border-l-4 border-ugr-green pl-4">
          {entrada.description}
        </p>
      )}

      <div class="prose prose-lg max-w-none text-ugr-text prose-headings:text-ugr-green-dark prose-a:text-ugr-green">
        <Content />
      </div>

      <div class="mt-12 text-center">
        <a href="/entradas/" class="btn-green inline-block px-6 py-3">
          ← Volver a Entradas
        </a>
      </div>

      <GiscusComments />
    </div>
  </section>
</Layout>
