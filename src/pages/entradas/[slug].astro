---
import Layout from '../../layouts/Layout.astro';
import TermPills from '../../components/TermPills.astro';
import GiscusComments from '../../components/GiscusComments.astro';
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import {
  getCategorias,
  getEtiquetas,
  slugTitleMap,
  formatDate,
  filterPublished,
} from '../../lib/taxonomies';
import { resolvePublicImageUrl } from '../../lib/public-image';
import { getSimposioDefault } from '../../lib/simposios';

type Props = {
  entry: CollectionEntry<'entradas'>;
};

export const getStaticPaths: GetStaticPaths = async () => {
  const entradas = filterPublished(await getCollection('entradas'));
  const defaultSimposio = await getSimposioDefault();
  return entradas
    .filter((entry) => entry.data.simposio === defaultSimposio?.data.slug)
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
};

const { entry } = Astro.props;
const { Content } = await render(entry);
const entrada = entry.data;

const catTitles = slugTitleMap(await getCategorias());
const tagTitles = slugTitleMap(await getEtiquetas());

const allPublished = filterPublished(await getCollection('entradas'));
const related = allPublished
  .filter(
    (e) =>
      e.id !== entry.id &&
      ((e.data.categories || []).some((c) => (entrada.categories || []).includes(c)) ||
        (e.data.tags || []).some((t) => (entrada.tags || []).includes(t)))
  )
  .slice(0, 3);
---

<Layout
  title={`${entrada.title} - Entradas`}
  description={entrada.description}
  image={entrada.image || undefined}
  type="article"
  canonical={`/entradas/${entry.id}/`}
  publishDate={entrada.publish_date || entrada.date}
  author={entrada.author}
  authorType="Person"
  section={entrada.categories[0]}
  tags={entrada.tags}
  keywords={[...entrada.categories, ...entrada.tags]}
>
  <section class="bg-ugr-green py-14 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <nav class="text-white/70 text-sm mb-4">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <span class="mx-2">/</span>
        <a href="/entradas/" class="hover:text-white transition-colors">Entradas</a>
        <span class="mx-2">/</span>
        <span class="text-white">{entrada.title}</span>
      </nav>
      <h1
        class="text-3xl md:text-4xl font-bold text-white font-[family-name:var(--font-heading)] drop-shadow-lg max-w-4xl mx-auto"
      >
        {entrada.title}
      </h1>
      {
        (entrada.date || entrada.author) && (
          <p class="mt-3 text-white/80 text-sm">
            {formatDate(entrada.date)}
            {entrada.date && entrada.author ? ' · ' : ''}
            {entrada.author}
          </p>
        )
      }
    </div>
  </section>

  <section class="py-12 bg-white">
    <div class="max-w-3xl mx-auto px-4">
      {
        entrada.image && (
          <div class="mb-8">
            <img
              src={resolvePublicImageUrl(entrada.image)}
              alt={entrada.title}
              class="w-full rounded-xl shadow-lg object-cover"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        )
      }

      <div class="mb-6">
        <TermPills
          categories={entrada.categories}
          tags={entrada.tags}
          catTitles={catTitles}
          tagTitles={tagTitles}
        />
      </div>

      {
        entrada.description && (
          <p class="text-lg text-ugr-text leading-relaxed mb-8 font-medium border-l-4 border-ugr-green pl-4">
            {entrada.description}
          </p>
        )
      }

      <div
        class="prose prose-lg max-w-none text-ugr-text prose-headings:text-ugr-green-dark prose-a:text-ugr-green"
      >
        <Content />
      </div>

      {
        related.length > 0 && (
          <div class="mt-12 pt-8 border-t border-gray-200">
            <h2 class="text-2xl font-bold text-ugr-green-dark mb-6 font-[family-name:var(--font-heading)]">
              Entradas relacionadas
            </h2>
            <div class="grid gap-6 md:grid-cols-3">
              {related.map((r) => (
                <a
                  href={`/entradas/${r.id}`}
                  class="block bg-gray-50 rounded-xl p-4 hover:bg-ugr-green/5 transition-colors"
                >
                  {r.data.image && (
                    <img
                      src={resolvePublicImageUrl(r.data.image)}
                      alt={r.data.title}
                      class="w-full h-32 object-cover rounded-lg mb-3"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  <h3 class="font-bold text-ugr-green-dark text-sm line-clamp-2">{r.data.title}</h3>
                  {r.data.date && (
                    <p class="text-xs text-ugr-text-light mt-1">{formatDate(r.data.date)}</p>
                  )}
                </a>
              ))}
            </div>
          </div>
        )
      }

      <div class="mt-12 text-center">
        <a href="/entradas/" class="btn-green inline-block px-6 py-3"> ← Volver a Entradas </a>
      </div>

      <GiscusComments />
    </div>
  </section>
</Layout>
